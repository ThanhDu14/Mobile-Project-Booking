rules_version = '2';

// Rules nền dùng chung. Quyền chi tiết của từng collection do người phụ trách
// viết (đặc tả CSDL mục 2 và mục 7), kèm test "được phép" và "bị chặn" trong
// firestore-tests/.
//
// Không có rule nào khớp thì Firestore chặn, nên collection chưa khai báo
// match là client không đọc/ghi được. Trường 🔒 và thao tác nhạy cảm do Edge
// Functions ghi bằng service account, không đi qua Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Vai trò của app nằm ở custom claim `appRole`; claim `role` dành cho
    // Supabase (constitution, mục Ràng buộc công nghệ). Thiếu claim (chưa qua
    // on-signup) thì trả null, không coi là PLAYER (spec 010, research R10).
    function appRole() {
      return isSignedIn() ? request.auth.token.get('appRole', null) : null;
    }

    // Đã qua on-signup: có claim appRole. Dùng thay isSignedIn() cho quyền
    // của người dùng, nhất là quyền ghi.
    function isInitialized() {
      return appRole() != null;
    }

    function isPlayer() {
      return appRole() == 'PLAYER';
    }

    function isOwner() {
      return appRole() == 'OWNER';
    }

    function isAdmin() {
      return appRole() == 'ADMIN';
    }

    // Client chỉ được ghi đúng các trường cho phép.
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // createdAt/updatedAt phải ghi bằng serverTimestamp() (đặc tả CSDL mục 1).
    function hasServerTimestamps() {
      return request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
    }

    // Người phụ trách thêm `match /<collection>/{id} { ... }` bên dưới.

    // ---------- users (A, spec 010; contracts/security-rules.md) ----------
    // Tạo bởi on-signup, xóa bởi delete-account (service account, không qua Rules).
    // Không áp dụng xuống subcollection: favorites, notifications, aiUsage có match riêng.
    match /users/{uid} {
      // Trường người dùng tự sửa được. Spec 011 bổ sung kiểm tra chi tiết từng trường.
      function selfEditableFields() {
        return ['displayName', 'avatarPath', 'level', 'favoriteDistrictIds',
                'fcmTokens', 'notificationPrefs', 'updatedAt'];
      }

      function validDisplayName() {
        return !('displayName' in request.resource.data.diff(resource.data).affectedKeys())
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() >= 2
                && request.resource.data.displayName.size() <= 50);
      }

      allow get: if (isSelf(uid) && isInitialized()) || isAdmin();
      allow list: if isAdmin();                       // spec 120 tra cứu người dùng
      allow create, delete: if false;
      allow update: if isSelf(uid) && isInitialized()
                    && onlyChanges(selfEditableFields())
                    && request.resource.data.updatedAt == request.time
                    && validDisplayName();
    }
  }
}
