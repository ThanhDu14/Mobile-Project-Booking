// BẢN GỘP DRAFT — chưa deploy. Cách gộp: lấy file rules đang chạy trên Firestore
// (bản Đại ca paste từ Console) làm nền, giữ nguyên khối users bản 011 + districts +
// accountDeletions, rồi thêm khối venues/courts/priceRules + slots từ repo.
// LƯU Ý: bản deploy Đại ca paste kết thúc bằng dấu phẩy thừa — hãy xác nhận không còn
// match nào khác phía dưới accountDeletions trước khi dùng bản này để deploy.
rules_version = '2';

// Rules nền dùng chung. Quyền chi tiết của từng collection do người phụ trách
// viết (đặc tả CSDL mục 2 và mục 7), kèm test "được phép" và "bị chặn" trong
// firestore-tests/.
//
// Không có rule nào khớp thì Firestore chặn, nên collection chưa khai báo
// match là client không đọc/ghi được. Trường 🔒 và thao tác nhạy cảm do Edge
// Functions ghi bằng service account, không đi qua Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Vai trò của app nằm ở custom claim `appRole`; claim `role` dành cho
    // Supabase (constitution, mục Ràng buộc công nghệ). Thiếu claim (chưa qua
    // on-signup) thì trả null, không coi là PLAYER (spec 010, research R10).
    function appRole() {
      return isSignedIn() ? request.auth.token.get('appRole', null) : null;
    }

    // Đã qua on-signup: có claim appRole. Dùng thay isSignedIn() cho quyền
    // của người dùng, nhất là quyền ghi.
    function isInitialized() {
      return appRole() != null;
    }

    function isPlayer() {
      return appRole() == 'PLAYER';
    }

    function isOwner() {
      return appRole() == 'OWNER';
    }

    // `appRole` identifies the role in the token; approval remains a server-read
    // value so a stale or forged role claim cannot grant owner mutations.
    function isApprovedOwner() {
      return isOwner()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ownerStatus == 'APPROVED';
    }

    function ownsVenue(venueId) {
      return isApprovedOwner()
          && get(/databases/$(database)/documents/venues/$(venueId)).data.ownerId == request.auth.uid;
    }

    function isAdmin() {
      return appRole() == 'ADMIN';
    }

    // Client chỉ được ghi đúng các trường cho phép.
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // createdAt/updatedAt phải ghi bằng serverTimestamp() (đặc tả CSDL mục 1).
    function hasServerTimestamps() {
      return request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
    }

    // Người phụ trách thêm `match /<collection>/{id} { ... }` bên dưới.

    // ---------- users (A, spec 010; contracts/security-rules.md) ----------
    // Tạo bởi on-signup, xóa bởi delete-account (service account, không qua Rules).
    // Không áp dụng xuống subcollection: favorites, notifications, aiUsage có match riêng.
    match /users/{uid} {
      // Trường người dùng tự sửa được. Spec 011 bổ sung kiểm tra chi tiết từng trường.
      function selfEditableFields() {
        return ['displayName', 'avatarPath', 'level', 'favoriteDistrictIds',
                'fcmTokens', 'notificationPrefs', 'updatedAt'];
      }

      function validDisplayName() {
        return !('displayName' in request.resource.data.diff(resource.data).affectedKeys())
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() >= 2
                && request.resource.data.displayName.size() <= 50);
      }

      // [011] contracts/security-rules.md §1
      function changed(field) {
        return field in request.resource.data.diff(resource.data).affectedKeys();
      }

      function validLevel() {
        return !changed('level')
            || request.resource.data.level == null
            || request.resource.data.level in ['BEGINNER', 'INTERMEDIATE', 'ADVANCED'];
      }

      function activeDistrict(id) {
        return get(/databases/$(database)/documents/districts/$(id)).data.isActive == true;
      }

      // 0–5 khu vực, không trùng, đều đang hoạt động; tối đa 5 lượt get() (giới hạn của Rules là 10).
      function validDistricts() {
        let ids = request.resource.data.favoriteDistrictIds;
        return !changed('favoriteDistrictIds')
            || (ids is list && ids.size() <= 5 && ids.toSet().size() == ids.size()
                && (ids.size() < 1 || activeDistrict(ids[0]))
                && (ids.size() < 2 || activeDistrict(ids[1]))
                && (ids.size() < 3 || activeDistrict(ids[2]))
                && (ids.size() < 4 || activeDistrict(ids[3]))
                && (ids.size() < 5 || activeDistrict(ids[4])));
      }

      // Ảnh nằm trong thư mục của chính mình trên bucket avatars (contracts/storage-avatars.md).
      function validAvatarPath() {
        let p = request.resource.data.avatarPath;
        return !changed('avatarPath')
            || p == null
            || (p is string && p.matches(uid + '/avatar_[0-9]{13}[.]jpg'));
      }

      allow get: if (isSelf(uid) && isInitialized()) || isAdmin();
      allow list: if isAdmin();                       // spec 120 tra cứu người dùng
      allow create, delete: if false;
      allow update: if isSelf(uid) && isInitialized()
                    && onlyChanges(selfEditableFields())
                    && request.resource.data.updatedAt == request.time
                    && validDisplayName() && validLevel() && validDistricts() && validAvatarPath();
    }

    // ---------- districts (A, spec 011; contracts/security-rules.md §2) ----------
    match /districts/{id} {
      allow get, list: if isInitialized();
      allow write: if isAdmin();                      // spec 120 làm màn hình quản lý
    }

    // ---------- accountDeletions (A, spec 011; contracts/security-rules.md §3) ----------
    // Chỉ delete-account và delete-account-sweeper (service account) đọc/ghi.
    match /accountDeletions/{uid} {
      allow read, write: if false;
    }

    // ---------- reviews (C, spec 070; contracts/security-rules.md §1) ----------
    // Đánh giá đang hiển thị: ai đăng nhập cũng đọc được; người viết đọc được bài của mình kể cả
    // khi bị ẩn; admin đọc tất cả. Truy vấn list phải lọc `status == VISIBLE` hoặc `userId == uid`.
    // Mọi ghi đi qua Edge Function `review` (service account bỏ qua Rules).
    match /reviews/{reviewId} {
      allow get, list: if isSignedIn() && (
          resource.data.status == 'VISIBLE'
          || resource.data.userId == request.auth.uid
          || isAdmin());
      allow write: if false;
    }

    // ---------- users/{uid}/favorites (C, spec 070; contracts/security-rules.md §1) ----------
    // Client ghi trực tiếp (research R7). ID document = venueId nên lưu hai lần không tạo bản trùng.
    // Không có rule cho collection group `favorites`: chỉ Edge Function của D (service account) truy vấn.
    match /users/{uid}/favorites/{venueId} {
      allow read, delete: if isSelf(uid);
      allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['venueId', 'venueSnapshot', 'createdAt'])
          && request.resource.data.venueId == venueId
          && request.resource.data.createdAt == request.time
          && request.resource.data.venueSnapshot is map
          && request.resource.data.venueSnapshot.keys().hasOnly(['name', 'photoPath', 'address']);
    }

    // ---------- venues, courts, priceRules (B, spec 040 / D, spec 111) ----------
    // Người chơi chỉ thấy dữ liệu công khai của venue ACTIVE. Owner đã duyệt
    // vẫn đọc được dữ liệu quản lý của venue mình.
    match /venues/{venueId} {
      // So ownerId trên chính document (không get() lại venue) để query `where ownerId == uid`
      // của màn "Cơ sở của tôi" chứng minh được quyền; ownsVenue(venueId) chỉ dùng được cho get.
      allow read: if isAdmin() || (resource.data.status == 'ACTIVE')
                  || (isApprovedOwner() && resource.data.ownerId == request.auth.uid);
      allow create: if isAdmin(); // venue đầu tiên do Feature 120 tạo; owner create chờ server boundary T003.
      allow update: if isAdmin()
                    || (ownsVenue(venueId)
                        && resource.data.status != 'LOCKED'
                        && request.resource.data.ownerId == resource.data.ownerId
                        && request.resource.data.status in ['ACTIVE', 'HIDDEN']
                        && onlyChanges(['name', 'nameKeywords', 'address', 'districtId', 'location',
                                        'geohash', 'openTime', 'closeTime', 'phone', 'amenityIds',
                                        'photoPaths', 'courtCount', 'acceptsRecurring', 'status']));
      allow delete: if isAdmin();

      match /courts/{courtId} {
        allow read: if isAdmin() || (get(/databases/$(database)/documents/venues/$(venueId)).data.status == 'ACTIVE') || ownsVenue(venueId);
        allow create: if isAdmin()
                      || (ownsVenue(venueId)
                          && request.resource.data.keys().hasOnly(['name', 'surfaceType', 'isActive', 'sortOrder']));
        allow update: if isAdmin()
                      || (ownsVenue(venueId)
                          && onlyChanges(['name', 'surfaceType', 'isActive', 'sortOrder']));
        allow delete: if isAdmin();
      }

      match /priceRules/{ruleId} {
        allow read: if isAdmin() || (get(/databases/$(database)/documents/venues/$(venueId)).data.status == 'ACTIVE') || ownsVenue(venueId);
        allow create: if isAdmin()
                      || (ownsVenue(venueId)
                          && request.resource.data.keys().hasOnly(['daysOfWeek', 'startTime', 'endTime', 'pricePerHour', 'label']));
        allow update: if isAdmin()
                      || (ownsVenue(venueId)
                          && onlyChanges(['daysOfWeek', 'startTime', 'endTime', 'pricePerHour', 'label']));
        allow delete: if isAdmin() || ownsVenue(venueId);
      }
    }

    // ---------- slots (B, spec 040; tasks.md T022) ----------
    // Lắng nghe realtime công khai các khung giờ bận/trống.
    // Giữ chỗ HELD 5 phút khi đã đăng nhập, slot chưa có người giữ hoặc đã hết hạn,
    // và thời gian hết hạn không được vượt quá 5 phút so với request.time (chống lùi/ăn gian giờ).
    match /slots/{slotId} {
      allow read: if true;

      allow create: if isSignedIn()
                    && request.resource.data.status == 'HELD'
                    && request.resource.data.holdBy == request.auth.uid
                    && request.resource.data.holdExpiresAt is timestamp
                    && request.resource.data.holdExpiresAt <= request.time + duration.value(5, 'm')
                    && request.resource.data.holdExpiresAt > request.time;

      allow update: if isSignedIn()
                    && (
                      // Đặt giữ chỗ slot đã tồn tại nhưng đã hết hạn hoặc do chính mình giữ
                      (
                        request.resource.data.status == 'HELD'
                        && request.resource.data.holdBy == request.auth.uid
                        && request.resource.data.holdExpiresAt is timestamp
                        && request.resource.data.holdExpiresAt <= request.time + duration.value(5, 'm')
                        && request.resource.data.holdExpiresAt > request.time
                        && (resource.data.status != 'BOOKED' && resource.data.status != 'BLOCKED')
                        && (resource.data.status != 'HELD' || resource.data.holdExpiresAt < request.time || resource.data.holdBy == request.auth.uid)
                      )
                      // Hủy giữ chỗ hoặc nhả slot về AVAILABLE bởi chính người đang giữ
                      || (
                        request.resource.data.status == 'AVAILABLE'
                        && resource.data.holdBy == request.auth.uid
                      )
                    );

      allow delete: if isAdmin() || (isSignedIn() && resource.data.holdBy == request.auth.uid);
    }
  }
}
