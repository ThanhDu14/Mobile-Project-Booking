// BẢN GỘP DRAFT — chưa deploy. Cách gộp: lấy file rules đang chạy trên Firestore
// (bản paste từ Console) làm nền, giữ nguyên khối users bản 011 + districts +
// accountDeletions, rồi thêm khối venues/courts/priceRules + slots từ repo.
// LƯU Ý: bản deploy đã paste kết thúc bằng dấu phẩy thừa — hãy xác nhận không còn
// match nào khác phía dưới accountDeletions trước khi dùng bản này để deploy.
// 03/11/2026: thêm khối recurringGroups + bookings (B, spec 041).
rules_version = '2';

// Rules nền dùng chung. Quyền chi tiết của từng collection do người phụ trách
// viết (đặc tả CSDL mục 2 và mục 7), kèm test "được phép" và "bị chặn" trong
// firestore-tests/.
//
// Không có rule nào khớp thì Firestore chặn, nên collection chưa khai báo
// match là client không đọc/ghi được. Trường 🔒 và thao tác nhạy cảm do Edge
// Functions ghi bằng service account, không đi qua Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Vai trò của app nằm ở custom claim `appRole`; claim `role` dành cho
    // Supabase (constitution, mục Ràng buộc công nghệ). Thiếu claim (chưa qua
    // on-signup) thì trả null, không coi là PLAYER (spec 010, research R10).
    function appRole() {
      return isSignedIn() ? request.auth.token.get('appRole', null) : null;
    }

    // Đã qua on-signup: có claim appRole. Dùng thay isSignedIn() cho quyền
    // của người dùng, nhất là quyền ghi.
    function isInitialized() {
      return appRole() != null;
    }

    function isPlayer() {
      return appRole() == 'PLAYER';
    }

    function isOwner() {
      return appRole() == 'OWNER';
    }

    // `appRole` identifies the role in the token; approval remains a server-read
    // value so a stale or forged role claim cannot grant owner mutations.
    function isApprovedOwner() {
      return isOwner()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null) == 'OWNER'
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('ownerStatus', null) == 'APPROVED'
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountStatus', null) == 'ACTIVE'
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('deletionRequestedAt', null) == null;
    }

    function ownsVenue(venueId) {
      return isApprovedOwner()
          && get(/databases/$(database)/documents/venues/$(venueId)).data.ownerId == request.auth.uid;
    }

    function isAdmin() {
      return appRole() == 'ADMIN'
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null) == 'ADMIN'
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountStatus', null) == 'ACTIVE'
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('deletionRequestedAt', null) == null;
    }

    // Client chỉ được ghi đúng các trường cho phép.
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // createdAt/updatedAt phải ghi bằng serverTimestamp() (đặc tả CSDL mục 1).
    function hasServerTimestamps() {
      return request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
    }

    // Người phụ trách thêm `match /<collection>/{id} { ... }` bên dưới.

    // ---------- users (A, spec 010; contracts/security-rules.md) ----------
    // Tạo bởi on-signup, xóa bởi delete-account (service account, không qua Rules).
    // Không áp dụng xuống subcollection. Subcollection có match riêng: favorites, searchHistory.
    // aiUsage chỉ do Edge Function ghi/đọc (service account); client không có match
    // nên mặc định bị từ chối. App lấy lượt AI qua function ai-search-parse.
    match /users/{uid}/notifications/{notificationId} {
      allow read: if isSelf(uid);
      allow update: if isSelf(uid)
          && onlyChanges(['isRead'])
          && request.resource.data.isRead is bool;
      allow create, delete: if false;
    }

    match /users/{uid} {
      // Trường người dùng tự sửa được. Spec 011 bổ sung kiểm tra chi tiết từng trường.
      function selfEditableFields() {
        return ['displayName', 'avatarPath', 'level', 'favoriteDistrictIds',
                'fcmTokens', 'notificationPrefs', 'updatedAt'];
      }

      function validDisplayName() {
        return !('displayName' in request.resource.data.diff(resource.data).affectedKeys())
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() >= 2
                && request.resource.data.displayName.size() <= 50);
      }

      function validFcmTokens() {
        let old = resource.data.get('fcmTokens', []);
        let next = request.resource.data.get('fcmTokens', []);
        let added = next.removeAll(old);
        let removed = old.toSet().difference(next.toSet());
        return !changed('fcmTokens') || (next is list && old is list
            && added.size() <= 1 && removed.size() <= 1
            && (added.size() == 0 || (added[0] is string && added[0].size() > 0 && added[0].size() <= 4096)));
      }

      // [011] contracts/security-rules.md §1
      function changed(field) {
        return field in request.resource.data.diff(resource.data).affectedKeys();
      }

      function validLevel() {
        return !changed('level')
            || request.resource.data.level == null
            || request.resource.data.level in ['BEGINNER', 'INTERMEDIATE', 'ADVANCED'];
      }

      function activeDistrict(id) {
        return get(/databases/$(database)/documents/districts/$(id)).data.isActive == true;
      }

      // 0–5 khu vực, không trùng, đều đang hoạt động; tối đa 5 lượt get() (giới hạn của Rules là 10).
      function validDistricts() {
        let ids = request.resource.data.favoriteDistrictIds;
        return !changed('favoriteDistrictIds')
            || (ids is list && ids.size() <= 5 && ids.toSet().size() == ids.size()
                && (ids.size() < 1 || activeDistrict(ids[0]))
                && (ids.size() < 2 || activeDistrict(ids[1]))
                && (ids.size() < 3 || activeDistrict(ids[2]))
                && (ids.size() < 4 || activeDistrict(ids[3]))
                && (ids.size() < 5 || activeDistrict(ids[4])));
      }

      // Ảnh nằm trong thư mục của chính mình trên bucket avatars (contracts/storage-avatars.md).
      function validAvatarPath() {
        let p = request.resource.data.avatarPath;
        return !changed('avatarPath')
            || p == null
            || (p is string && p.matches(uid + '/avatar_[0-9]{13}[.]jpg'));
      }

      allow get: if (isSelf(uid) && isInitialized()) || isAdmin();
      allow list: if isAdmin();                       // spec 120 tra cứu người dùng
      allow create, delete: if false;
      allow update: if isSelf(uid) && isInitialized()
                    && onlyChanges(selfEditableFields())
                    && request.resource.data.updatedAt == request.time
                    && validDisplayName() && validLevel() && validDistricts() && validAvatarPath() && validFcmTokens();
    }

    // ---------- districts (A, spec 011; contracts/security-rules.md §2) ----------
    match /districts/{id} {
      allow get, list: if isInitialized();
      allow write: if isAdmin();                      // spec 120 làm màn hình quản lý
    }

    // ---------- amenities (D, spec 120) ----------
    match /amenities/{id} {
      allow get, list: if isInitialized();
      allow write: if isAdmin();                      // spec 120 làm màn hình quản lý
    }

    // ---------- accountDeletions (A, spec 011; contracts/security-rules.md §3) ----------
    // Chỉ delete-account và delete-account-sweeper (service account) đọc/ghi.
    match /accountDeletions/{uid} {
      allow read, write: if false;
    }

    // ---------- reviews (C, spec 070; contracts/security-rules.md §1) ----------
    // Đánh giá đang hiển thị: ai đăng nhập cũng đọc được; người viết đọc được bài của mình kể cả
    // khi bị ẩn; admin đọc tất cả. Truy vấn list phải lọc `status == VISIBLE` hoặc `userId == uid`.
    // Mọi ghi đi qua Edge Function `review` (service account bỏ qua Rules).
    match /reviews/{reviewId} {
      // resource == null: đơn chưa có đánh giá, `observeMyReview` cần nhận "không tồn tại" thay vì lỗi quyền.
      // Đánh giá VISIBLE công khai, khách chưa đăng nhập cũng đọc được (chi tiết sân spec 030 VD-6).
      allow get: if (resource != null && resource.data.status == 'VISIBLE')
          || (isSignedIn() && (
              resource == null
              || resource.data.userId == request.auth.uid
              || isAdmin()));
      allow list: if resource.data.status == 'VISIBLE'
          || (isSignedIn() && (
              resource.data.userId == request.auth.uid
              || isAdmin()));
      allow write: if false;
    }

    // ---------- ownerApplications (D, spec 110/120) ----------
    // Submit/re-submit and all server-controlled status changes go through
    // owner-applications Edge Function + Firestore transaction. Clients may
    // only read their own application (onboarding or additional venue).
    // Application status is independent from account ownerStatus for additions.
    // Admin review reads remain privileged; purpose/uid/status are server-only.
    match /ownerApplications/{applicationId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // ---------- users/{uid}/favorites (C, spec 070; contracts/security-rules.md §1) ----------
    // Client ghi trực tiếp (research R7). ID document = venueId nên lưu hai lần không tạo bản trùng.
    // Không có rule cho collection group `favorites`: chỉ Edge Function của D (service account) truy vấn.
    match /users/{uid}/favorites/{venueId} {
      allow read, delete: if isSelf(uid);
      allow create, update: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['venueId', 'venueSnapshot', 'createdAt'])
          && request.resource.data.venueId == venueId
          && request.resource.data.createdAt == request.time
          && request.resource.data.venueSnapshot is map
          && request.resource.data.venueSnapshot.keys().hasOnly(['name', 'photoPath', 'address']);
    }

    // Spec 050 data-model §1.7: tài khoản nhận chuyển khoản của chủ sân (form ở 111). Không đổi thì bỏ qua;
    // có đổi thì phải đủ đúng 4 trường: BIN NAPAS 6 số, số tài khoản 6–19 chữ số, tên ngân hàng và chủ tài khoản.
    function validPayoutAccountChange() {
      return request.resource.data.get('payoutAccount', null) == resource.data.get('payoutAccount', null)
          || isValidPayoutAccount(request.resource.data.get('payoutAccount', null));
    }

    function isValidPayoutAccount(p) {
      return p is map
          && p.keys().hasOnly(['bankBin', 'bankShortName', 'accountNumber', 'accountHolderName'])
          && p.keys().hasAll(['bankBin', 'bankShortName', 'accountNumber', 'accountHolderName'])
          && p.bankBin is string && p.bankBin.matches('^[0-9]{6}$')
          && p.accountNumber is string && p.accountNumber.matches('^[0-9]{6,19}$')
          && p.bankShortName is string && p.bankShortName.size() > 0
          && p.accountHolderName is string && p.accountHolderName.size() > 0;
    }

    // ---------- users/{uid}/searchHistory (A, spec 020 US4; contracts/security-rules-and-indexes.md §1) ----------
    // ID = 20 ký tự hex đầu SHA-256 của bộ điều kiện, nên tìm lại cùng tổ hợp ghi đè đúng document.
    // Không có vị trí (FR-014). App giữ tối đa 10 mục; xóa cùng tài khoản do delete-account (service account).
    match /users/{uid}/searchHistory/{historyId} {
      function historyFields() {
        return ['keyword', 'districtId', 'priceMin', 'priceMax', 'date', 'startTime', 'endTime',
                'amenityIds', 'sort', 'searchedAt', 'createdAt', 'updatedAt'];
      }

      function optString(d, f, maxLen) {
        return !(f in d) || d[f] == null || (d[f] is string && d[f].size() <= maxLen);
      }

      function optPrice(d, f) {
        // Bội số 1.000 (không phải 10.000 như contract ban đầu): AI điền được "dưới 55k" = 55.000.
        return !(f in d) || d[f] == null || (d[f] is int && d[f] >= 0 && d[f] % 1000 == 0);
      }

      function validWindow(d) {
        let none = (!('date' in d) || d.date == null)
                && (!('startTime' in d) || d.startTime == null)
                && (!('endTime' in d) || d.endTime == null);
        let all = d.get('date', null) is string && d.date.matches('^[0-9]{8}$')
               && d.get('startTime', null) is string && d.startTime.matches('^[0-9]{2}(00|30)$')
               && d.get('endTime', null) is string && d.endTime.matches('^[0-9]{2}(00|30)$')
               && d.endTime > d.startTime;
        return none || all;
      }

      function validHistory(d) {
        return d.keys().hasOnly(historyFields())
            && d.keyword is string && d.keyword.size() <= 100
            && optString(d, 'districtId', 40)
            && optPrice(d, 'priceMin') && optPrice(d, 'priceMax')
            && (d.get('priceMin', null) == null || d.get('priceMax', null) == null
                || d.priceMin <= d.priceMax)
            && validWindow(d)
            && d.amenityIds is list && d.amenityIds.size() <= 20
            && d.sort in ['RATING', 'PRICE_ASC', 'NEAREST']
            && d.searchedAt == request.time;
      }

      allow read, delete: if isSelf(uid) && isInitialized();
      allow create: if isSelf(uid) && isInitialized()
                    && validHistory(request.resource.data)
                    && hasServerTimestamps();
      allow update: if isSelf(uid) && isInitialized()
                    && validHistory(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.updatedAt == request.time;
    }

    // ---------- venues, courts, priceRules (B, spec 040 / D, spec 111) ----------
    // Người chơi chỉ thấy dữ liệu công khai của venue ACTIVE. Owner đã duyệt
    // vẫn đọc được dữ liệu quản lý của venue mình.
    match /venues/{venueId} {
      // So ownerId trên chính document (không get() lại venue) để query `where ownerId == uid`
      // của màn "Cơ sở của tôi" chứng minh được quyền; ownsVenue(venueId) chỉ dùng được cho get.
      allow read: if isAdmin() || (resource.data.status == 'ACTIVE')
                  || (isApprovedOwner() && resource.data.ownerId == request.auth.uid);
      allow create: if false; // Initial/additional venues are created only by trusted server review.
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['courtCount', 'minPricePerHour'])
                    && (isAdmin() || (ownsVenue(venueId)
                        && resource.data.status != 'LOCKED'
                        && request.resource.data.ownerId == resource.data.ownerId
                        && request.resource.data.status in ['ACTIVE', 'HIDDEN']
                        && onlyChanges(['name', 'nameKeywords', 'address', 'districtId', 'location',
                                        'geohash', 'openTime', 'closeTime', 'phone', 'amenityIds',
                                        'photoPaths', 'acceptsRecurring', 'status', 'payoutAccount'])
                        && validPayoutAccountChange()));
      allow delete: if isAdmin();

      match /courts/{courtId} {
        allow read: if isAdmin() || (get(/databases/$(database)/documents/venues/$(venueId)).data.status == 'ACTIVE') || ownsVenue(venueId);
        // Server validates court fields/current authority and updates active courtCount atomically.
        allow write: if false;
      }

      match /priceRules/{ruleId} {
        allow read: if isAdmin() || (get(/databases/$(database)/documents/venues/$(venueId)).data.status == 'ACTIVE') || ownsVenue(venueId);
        // Cross-rule overlap and the protected minimum are validated atomically by the server.
        allow write: if false;
      }

      // Venue voucher mutations and usage counters are exclusively server-owned.
      // Spec 050 R7: màn thanh toán đọc voucher của cơ sở ACTIVE để xem trước giá; tạo/sửa qua Edge Function
      // owner-create-voucher. userUsage/redemptions bên dưới không có match nên client không đọc/ghi được.
      match /vouchers/{code} {
        allow read: if isSignedIn() && (isAdmin() || ownsVenue(venueId)
            || get(/databases/$(database)/documents/venues/$(venueId)).data.status == 'ACTIVE');
        allow write: if false;
      }
    }

    // ---------- slots (B, spec 040; tasks.md T022) ----------
    // Lắng nghe realtime công khai các khung giờ bận/trống.
    // Giữ chỗ HELD 5 phút khi đã đăng nhập, slot chưa có người giữ hoặc đã hết hạn,
    // và thời gian hết hạn không được vượt quá 5 phút so với request.time (chống lùi/ăn gian giờ).
    match /slots/{slotId} {
      allow read: if true;

      allow create: if isSignedIn()
                    && request.resource.data.status == 'HELD'
                    && request.resource.data.holdBy == request.auth.uid
                    && request.resource.data.holdExpiresAt is timestamp
                    && request.resource.data.holdExpiresAt <= request.time + duration.value(5, 'm')
                    && request.resource.data.holdExpiresAt > request.time;

      allow update: if isSignedIn()
                    && (
                      // Đặt giữ chỗ slot đã tồn tại nhưng đã hết hạn hoặc do chính mình giữ
                      (
                        request.resource.data.status == 'HELD'
                        && request.resource.data.holdBy == request.auth.uid
                        && request.resource.data.holdExpiresAt is timestamp
                        && request.resource.data.holdExpiresAt <= request.time + duration.value(5, 'm')
                        && request.resource.data.holdExpiresAt > request.time
                        && (resource.data.status != 'BOOKED' && resource.data.status != 'BLOCKED')
                        && (resource.data.status != 'HELD' || resource.data.holdExpiresAt < request.time || resource.data.holdBy == request.auth.uid)
                      )
                      // Hủy giữ chỗ: chỉ nhả slot ĐANG HELD do chính mình giữ. Slot đã BOOKED vẫn còn
                      // holdBy của người đặt, nên thiếu điều kiện status sẽ cho phép trả sân đã đặt về trống
                      // (đặt trùng). Hủy đơn đã đặt phải đi qua Edge Function.
                      || (
                        request.resource.data.status == 'AVAILABLE'
                        && resource.data.status == 'HELD'
                        && resource.data.holdBy == request.auth.uid
                      )
                    );

      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.status == 'HELD' && resource.data.holdBy == request.auth.uid);
    }

    // ---------- recurringGroups + bookings (B, spec 041) ----------
    // Giữ chỗ 041 ghi 3 collection trong 1 transaction: slots + recurringGroups
    // + bookings. slots đã có rule; 2 collection này trước đây chưa có match nên
    // transaction luôn bị chặn (PERMISSION_DENIED).
    match /recurringGroups/{groupId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isPlayer()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'HOLD'
          && request.resource.data.holdExpiresAt is timestamp
          && request.resource.data.holdExpiresAt <= request.time + duration.value(5, 'm')
          && request.resource.data.holdExpiresAt > request.time;
      // Status transitions are server-owned. In particular a client cannot
      // cancel a group until the recurring-group refund contract is defined.
      allow update: if false;
      allow delete: if false;
    }

    match /bookings/{bookingId} {
      // Chủ sân chỉ đọc đơn thuộc cơ sở của mình (spec 112 T012): get theo ID, hoặc query có
      // `where venueId == <cơ sở của mình>` (màn danh sách đơn). Tra đơn theo qrToken cho check-in
      // chạy ở Edge Function `checkin-booking`, client không query qrToken trên toàn collection.
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid
          || isAdmin() || ownsVenue(resource.data.venueId));
      // Spec 050 (T017): thu hồi "lát cắt test 050". App chỉ tạo đơn HOLD khi giữ chỗ (041); chốt đơn sang
      // PENDING, tiền, voucher và thông báo BOOKING_NEW chạy ở Edge Function booking-payment-confirm /
      // booking-payment-transfer / sepay-webhook.
      allow create: if isPlayer()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'HOLD';
      // Confirmation/refund are server-owned. Clients may only expire their own
      // unconfirmed HOLD; cancellation must use the server transaction.
      allow update: if isPlayer() && resource.data.userId == request.auth.uid
          && resource.data.status == 'HOLD'
          && onlyChanges(['status'])
          && request.resource.data.status == 'EXPIRED';
      allow delete: if false;
    }

    // ---------- reports (D, spec 120) ----------
    // Community mutations go through server functions; a group owner cannot
    // delete or unlock a LOCKED group directly, including by changing status.
    match /groups/{groupId} {
      allow read: if isAdmin();
      allow write: if false;

      // Moderation opens one reported document. Membership permissions belong
      // to the community feature; this does not grant collection access.
      match /posts/{postId} {
        allow get: if isAdmin();
        allow list, write: if false;
      }
    }

    match /chats/{chatId}/messages/{messageId} {
      allow get: if isAdmin();
      allow list, write: if false;
    }

    match /reports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- systemStats (D, spec 120) ----------
    match /systemStats/{date} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- systemVouchers (D, spec 120 / Feature 050) ----------
    match /systemVouchers/{code} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---------- thanh toán chuyển khoản, hoàn tiền (spec 050) ----------
    // paymentCodes (bảng tra mã SNP… → đơn) và sepayTransactions (sổ chống trùng của webhook) chỉ Edge Function
    // đọc/ghi. Viết match chặn hết cho rõ ý, dù không có match cũng đã bị chặn.
    match /paymentCodes/{code} {
      allow read, write: if false;
    }

    match /sepayTransactions/{sepayId} {
      allow read, write: if false;
    }

    // Khoản cần hoàn thủ công (data-model §1.5). Người chơi đọc khoản của mình, chủ sân đọc khoản của cơ sở mình
    // (query phải có where userId / where venueId). Tạo, "Đã hoàn tiền", báo cáo đều qua Edge Function.
    match /refunds/{refundId} {
      allow read: if isSignedIn()
          && (resource.data.userId == request.auth.uid || ownsVenue(resource.data.venueId) || isAdmin());
      allow write: if false;
    }

    // ---------- dropInSessions + registrations (C, spec 080) ----------
    // specs/080-drop-in-session/contracts/security-rules.md. Client chỉ đọc;
    // đăng ký/hủy (registeredCount, status, đăng ký) đi qua Edge Function
    // register-drop-in/cancel-drop-in; tạo/sửa/hủy buổi của D (spec 112) cũng vậy.

    // Chủ cơ sở mở buổi: token OWNER và ownerId của buổi trùng uid.
    function isSessionOwner(sessionId) {
      return isOwner()
          && get(/databases/$(database)/documents/dropInSessions/$(sessionId)).data.ownerId == request.auth.uid;
    }

    match /dropInSessions/{sessionId} {
      // Ai cũng xem được danh sách và chi tiết buổi, kể cả khách chưa đăng nhập.
      allow read: if true;
      allow write: if false;

      match /registrations/{uid} {
        // get: ID document = uid, nên isSelf(uid) đủ (kể cả khi chưa có document).
        allow get: if isSelf(uid) || isSessionOwner(sessionId) || isAdmin();
        // list: người chơi chỉ liệt kê được khi truy vấn lọc userId == uid của
        // mình (Rules không phải bộ lọc); không lọc thì cả truy vấn bị chặn (D7).
        allow list: if (isSignedIn() && resource.data.userId == request.auth.uid)
            || isSessionOwner(sessionId)
            || isAdmin();
        allow write: if false;
      }
    }

    // "Lượt vãng lai của tôi": truy vấn collection group theo userId (D10, D11).
    // Collection group query chỉ khớp match có {path=**}, nên quyền ở match lồng
    // phía trên không áp dụng cho nó; chỉ mở list theo userId và cho admin.
    // Match này cũng khớp path dropInSessions/{sid}/registrations/{uid}, nhưng
    // không mở thêm quyền nào ngoài điều kiện userId == auth.uid đã có ở trên.
    match /{path=**}/registrations/{uid} {
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid)
          || isAdmin();
    }

    // ---------- groups + members/joinRequests/removals/posts/attendees (C, spec 090) ----------
    // specs/090-community-group/contracts/security-rules.md. Rules chỉ MỞ QUYỀN ĐỌC;
    // mọi ghi đi qua Edge Function group-manage/group-post (service account, bỏ qua Rules).
    match /groups/{groupId} {
      // Hàm dùng groupId của match này. Người chưa đăng nhập luôn là "không phải thành viên".
      function isMember() {
        return isSignedIn()
            && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
      }

      function myRole() {
        return get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role;
      }

      // Chủ nhóm hoặc quản trị viên (&& ngắn mạch nên không get() khi chưa là thành viên).
      function isMod() {
        return isMember() && myRole() in ['OWNER', 'ADMIN'];
      }

      // Trang giới thiệu: ai cũng đọc nhóm ACTIVE/LOCKED, kể cả khách chưa đăng nhập.
      // Nhóm DELETED (hoặc doc không tồn tại) thì điều kiện lỗi/sai → bị chặn.
      allow get, list: if resource.data.status in ['ACTIVE', 'LOCKED'];
      allow write: if false;

      match /members/{uid} {
        allow read: if isMember() || isAdmin();
        allow write: if false;
      }

      match /joinRequests/{uid} {
        allow read: if isSelf(uid) || isMod() || isAdmin();
        allow write: if false;
      }

      match /removals/{uid} {
        allow read: if isMod() || isAdmin();
        allow write: if false;
      }

      // list của thành viên thường chỉ qua khi query có where status == 'VISIBLE'
      // hoặc where authorId == uid mình (Rules không phải bộ lọc; research R6).
      match /posts/{postId} {
        // Admin chỉ get từng bài (xem bài bị báo cáo, spec 120), không list cả bảng tin.
        allow get: if isAdmin();
        allow read: if isMod()
            || (isMember() && (resource.data.status == 'VISIBLE'
                               || resource.data.authorId == request.auth.uid));
        allow write: if false;

        match /attendees/{uid} {
          allow read: if isMember() || isAdmin();
          allow write: if false;
        }
      }
    }

    // ---------- chats + participants/messages (C, spec 091) ----------
    // specs/091-chat/contracts/security-rules.md. Tin nhắn ghi qua Edge Function chat-send/chat-action;
    // client chỉ ghi chats.unreadCounts.{mình} = 0 và participants/{mình} (lastReadAt, muted, blockedOther, viewingUntil).
    // Feature 100 D1: service-account only; Admin clients have no delivery/receipt access.
    match /notificationDeliveries/{path=**} {
      allow read, write: if false;
    }
    match /notificationFanouts/{path=**} {
      allow read, write: if false;
    }
    match /groups/{groupId}/notificationCommands/{requestId} {
      allow read, write: if false;
    }

    match /chats/{chatId} {
      function inChat() {
        return isSignedIn() && request.auth.uid in resource.data.memberIds;
      }
      function inChatById() {
        return isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds;
      }

      allow get, list: if inChat() || isAdmin();
      // Chỉ đặt số chưa đọc của chính mình về 0.
      allow update: if inChat()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadCounts'])
          && request.resource.data.unreadCounts.diff(resource.data.unreadCounts).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.unreadCounts[request.auth.uid] == 0;
      allow create, delete: if false;

      match /participants/{uid} {
        match /presence/{installationId} {
          allow read: if isSelf(uid) && inChatById();
          allow create, update: if isSelf(uid) && inChatById()
              && request.resource.data.keys().hasOnly(['viewingUntil'])
              && request.resource.data.viewingUntil is timestamp
              && request.resource.data.viewingUntil <= request.time + duration.value(10, 'm');
          allow delete: if isSelf(uid) && inChatById();
        }
        allow get: if isSelf(uid) || isAdmin();
        allow update: if isSelf(uid) && inChatById()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['lastReadAt', 'muted', 'blockedOther', 'viewingUntil'])
            && (!('lastReadAt' in request.resource.data.diff(resource.data).affectedKeys())
                || request.resource.data.lastReadAt == request.time)
            && (!('viewingUntil' in request.resource.data.diff(resource.data).affectedKeys())
                || request.resource.data.viewingUntil == null
                || request.resource.data.viewingUntil <= request.time + duration.value(10, 'm'));
        allow create, delete: if false;
      }

      match /messages/{messageId} {
        // Admin chỉ get từng tin bị báo cáo (spec 120), không list cả cuộc trò chuyện.
        allow get: if isAdmin();
        allow read: if inChatById();
        allow write: if false;
      }
    }

    // Ẩn danh khi xóa tài khoản / kiểm tra tắt thông báo: collection group participants chỉ list theo userId mình.
    match /{path=**}/participants/{uid} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // "Nhóm của tôi": truy vấn collection group members theo userId.
    // Match này cũng khớp groups/{gid}/members/{uid} nhưng chỉ mở list khi
    // userId == uid mình, không mở thêm quyền ngoài điều kiện đó.
    match /{path=**}/members/{uid} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
