<?xml version="1.0" encoding="utf-8"?>
<!-- Thanh dưới màn hình viết đánh giá: nền bề mặt, đường kẻ trên 1dp. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sn_line" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/sn_surface_raised" />
        </shape>
    </item>
</layer-list>
