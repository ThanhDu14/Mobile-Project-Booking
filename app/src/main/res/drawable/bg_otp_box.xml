<?xml version="1.0" encoding="utf-8"?>
<!-- Ô một chữ số của mã OTP: viền court khi đang nhập (wireframe buoc5). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sn_surface_raised" />
            <stroke android:width="2dp" android:color="@color/sn_court" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sn_surface_raised" />
            <stroke android:width="1dp" android:color="@color/sn_outline" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
</selector>
