<?xml version="1.0" encoding="utf-8"?>
<!-- Dòng liên kết phụ của tab Cơ sở ("Hồ sơ mở thêm cơ sở"): nền trắng, viền mảnh, bo 12dp. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sn_surface_raised" />
            <stroke android:width="1dp" android:color="@color/sn_line" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
</ripple>
