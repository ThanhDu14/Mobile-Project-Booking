<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?android:attr/colorBackground" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true" android:paddingHorizontal="@dimen/screen_gutter" android:paddingTop="@dimen/space_4" android:text="@string/owner_statistics_title" android:textAppearance="?attr/textAppearanceHeadlineSmall" android:textColor="?attr/colorOnSurface" />
    <Spinner android:id="@+id/venueSpinner" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginHorizontal="@dimen/screen_gutter" android:contentDescription="@string/owner_calendar_select_venue" />
    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/periodGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/space_2" android:contentDescription="@string/owner_statistics_period">
        <com.google.android.material.button.MaterialButton android:id="@+id/day" style="@style/Widget.SmashNow.Button.Outlined" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/owner_calendar_day" />
        <com.google.android.material.button.MaterialButton android:id="@+id/week" style="@style/Widget.SmashNow.Button.Outlined" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/owner_calendar_week" />
        <com.google.android.material.button.MaterialButton android:id="@+id/custom" style="@style/Widget.SmashNow.Button.Outlined" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/owner_statistics_custom" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
    <LinearLayout android:id="@+id/navigationRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="@dimen/space_2">
        <com.google.android.material.button.MaterialButton android:id="@+id/previous" style="@style/Widget.SmashNow.Button.Text" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/owner_calendar_previous" android:text="‹" />
        <TextView android:id="@+id/periodLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnSurface" />
        <com.google.android.material.button.MaterialButton android:id="@+id/next" style="@style/Widget.SmashNow.Button.Text" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/owner_calendar_next" android:text="›" />
        <com.google.android.material.button.MaterialButton android:id="@+id/refresh" style="@style/Widget.SmashNow.Button.Text" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/common_retry" />
    </LinearLayout>
    <LinearLayout android:id="@+id/customRange" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="@dimen/screen_gutter" android:visibility="gone">
        <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="@string/owner_statistics_from"><com.google.android.material.textfield.TextInputEditText android:id="@+id/fromDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="date" android:minHeight="48dp" /></com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_2" android:layout_weight="1" android:hint="@string/owner_statistics_to"><com.google.android.material.textfield.TextInputEditText android:id="@+id/toDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="date" android:minHeight="48dp" /></com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
    <ProgressBar android:id="@+id/loading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:visibility="gone" />
    <TextView android:id="@+id/errorText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="@dimen/space_4" android:textColor="?attr/colorError" android:visibility="gone" />
    <TextView android:id="@+id/emptyText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="@dimen/space_4" android:text="@string/owner_statistics_empty" android:textColor="?attr/colorOnSurfaceVariant" android:visibility="gone" />
    <ScrollView android:id="@+id/reportScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/screen_gutter" android:paddingBottom="@dimen/space_4">
            <TextView android:id="@+id/freshness" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="@dimen/space_2" android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView android:id="@+id/revenue" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="@dimen/space_3" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnSurface" />
            <TextView android:id="@+id/occupancy" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="@dimen/space_3" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnSurface" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true" android:paddingTop="@dimen/space_3" android:text="@string/owner_statistics_peak_title" android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="?attr/colorOnSurface" />
            <com.example.booking_app.feature.owner.ui.statistics.PeakHoursChartView android:id="@+id/peakChart" android:layout_width="match_parent" android:layout_height="220dp" android:contentDescription="@string/owner_statistics_peak_chart" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
