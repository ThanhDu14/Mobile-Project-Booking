<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- Header: Đơn đặt & Cơ sở (Tablet) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_8"
        android:paddingTop="@dimen/space_6">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/owner_bookings_title"
                android:textAppearance="?attr/textAppearanceHeadlineLarge"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/venueSpinner"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:contentDescription="@string/owner_calendar_select_venue" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/refresh"
            style="@style/Widget.SmashNow.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="@dimen/touch_min"
            android:text="@string/common_retry" />
    </LinearLayout>

    <!-- Filter Chips (Tablet) -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/filterGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_8"
        android:layout_marginTop="@dimen/space_3"
        android:contentDescription="@string/owner_bookings_filter"
        app:checkedButton="@id/filterPending"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/filterPending"
            style="@style/Widget.SmashNow.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:paddingHorizontal="@dimen/space_6"
            android:text="@string/owner_bookings_pending" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/filterUpcoming"
            style="@style/Widget.SmashNow.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:paddingHorizontal="@dimen/space_6"
            android:text="@string/owner_bookings_upcoming" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/filterPast"
            style="@style/Widget.SmashNow.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:paddingHorizontal="@dimen/space_6"
            android:text="@string/owner_bookings_past" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Helpful Policy Note (Tablet) -->
    <TextView
        android:id="@+id/bookingsNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/space_8"
        android:paddingTop="@dimen/space_3"
        android:paddingBottom="@dimen/space_1"
        android:text="@string/owner_bookings_note"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <ProgressBar
        android:id="@+id/loading"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_4"
        android:visibility="gone" />

    <TextView
        android:id="@+id/errorText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/space_4"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorError"
        android:visibility="gone" />

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/space_4"
        android:text="@string/owner_bookings_empty"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/bookingScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/bookingList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_8"
            android:paddingBottom="@dimen/space_6" />
    </ScrollView>
</LinearLayout>
