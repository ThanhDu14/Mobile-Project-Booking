<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_gutter">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true" android:paddingTop="@dimen/space_4" android:text="@string/owner_booking_checkin_title" android:textAppearance="?attr/textAppearanceHeadlineSmall" android:textColor="?attr/colorOnSurface" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="@dimen/space_2" android:text="@string/owner_booking_checkin_help" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
    <com.google.android.material.button.MaterialButton android:id="@+id/scanQr" style="@style/Widget.SmashNow.Button" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="@dimen/space_4" android:contentDescription="@string/owner_booking_checkin_scan" android:text="@string/owner_booking_checkin_scan" />
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_3" android:hint="@string/owner_booking_checkin_code_label">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/bookingCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapCharacters" android:minHeight="@dimen/touch_min" android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/paymentCollected" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/touch_min" android:text="@string/owner_booking_checkin_payment_collected" />
    <TextView android:id="@+id/errorText" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="@dimen/space_3" android:textColor="?attr/colorError" android:visibility="gone" />
    <TextView android:id="@+id/successText" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="@dimen/space_3" android:textColor="?attr/colorPrimary" android:visibility="gone" />
    <ProgressBar android:id="@+id/loading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton android:id="@+id/submitCheckIn" style="@style/Widget.SmashNow.Button" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="@dimen/space_3" android:text="@string/owner_booking_checkin_submit" />
</LinearLayout>
