<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- Top Header: Title & Day/Week Toggle (Tablet) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_8"
        android:paddingTop="@dimen/space_6">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/owner_calendar_title"
            android:textAppearance="?attr/textAppearanceHeadlineLarge"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_maintenance"
            android:padding="2dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dayMode"
                style="@style/Widget.SmashNow.Button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minHeight="44dp"
                android:paddingHorizontal="@dimen/space_4"
                android:text="@string/owner_calendar_day"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/weekMode"
                style="@style/Widget.SmashNow.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minHeight="44dp"
                android:paddingHorizontal="@dimen/space_4"
                android:text="@string/owner_calendar_week"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_8">

        <Spinner
            android:id="@+id/venueSpinner"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_min"
            android:layout_weight="1"
            android:contentDescription="@string/owner_calendar_select_venue" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/refresh"
            style="@style/Widget.SmashNow.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:minHeight="@dimen/touch_min"
            android:text="@string/common_retry" />
    </LinearLayout>

    <!-- Date Navigator: ‹ Thứ Sáu, 09/10 › -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_6">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/previousPeriod"
            style="@style/Widget.SmashNow.Button.Text"
            android:layout_width="48dp"
            android:layout_height="@dimen/touch_min"
            android:contentDescription="@string/owner_calendar_previous"
            android:minHeight="@dimen/touch_min"
            android:text="‹"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/periodLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nextPeriod"
            style="@style/Widget.SmashNow.Button.Text"
            android:layout_width="48dp"
            android:layout_height="@dimen/touch_min"
            android:contentDescription="@string/owner_calendar_next"
            android:minHeight="@dimen/touch_min"
            android:text="›"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/loading"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_4"
        android:visibility="gone" />

    <TextView
        android:id="@+id/errorText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/space_4"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorError"
        android:visibility="gone" />

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/space_4"
        android:text="@string/owner_calendar_empty"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <!-- Calendar Matrix Grid Scroll -->
    <HorizontalScrollView
        android:id="@+id/calendarScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/calendarContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_6"
            android:paddingBottom="@dimen/space_4" />
    </HorizontalScrollView>

    <!-- Legend Footer -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:paddingVertical="@dimen/space_3"
        android:paddingHorizontal="@dimen/space_8"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/bg_pill_confirmed" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_1"
                android:layout_marginEnd="@dimen/space_4"
                android:text="@string/owner_calendar_legend_confirmed"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <View
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/bg_pill_dropin" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_1"
                android:layout_marginEnd="@dimen/space_4"
                android:text="@string/owner_calendar_legend_pending"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <View
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/bg_stat_card_mint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_1"
                android:layout_marginEnd="@dimen/space_4"
                android:text="@string/owner_calendar_legend_dropin"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <View
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/bg_pill_maintenance" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_1"
                android:layout_marginEnd="@dimen/space_4"
                android:text="@string/owner_calendar_legend_blocked"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <View
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/bg_preview_dashed_card" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_1"
                android:text="@string/owner_calendar_legend_hold"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
