<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- Top Header: Title & Venue & Refresh (Tablet) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_8"
        android:paddingTop="@dimen/space_6">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/owner_dropin_title"
                android:textAppearance="?attr/textAppearanceHeadlineLarge"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/venueSpinner"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_min"
                android:contentDescription="@string/owner_calendar_select_venue" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/refresh"
            style="@style/Widget.SmashNow.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="@dimen/touch_min"
            android:text="@string/common_retry" />
    </LinearLayout>

    <!-- Filter Tabs (Tablet) -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/dropInFilterGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_8"
        android:layout_marginTop="@dimen/space_2"
        android:contentDescription="@string/owner_dropin_title"
        app:checkedButton="@+id/tabUpcoming"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabUpcoming"
            style="@style/Widget.SmashNow.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:paddingHorizontal="@dimen/space_6"
            android:text="@string/owner_dropin_tab_upcoming" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabPast"
            style="@style/Widget.SmashNow.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:paddingHorizontal="@dimen/space_6"
            android:text="@string/owner_dropin_tab_past" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <ProgressBar
        android:id="@+id/loading"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_4"
        android:visibility="gone" />

    <TextView
        android:id="@+id/errorText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/space_4"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorError"
        android:visibility="gone" />

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/space_4"
        android:text="@string/owner_dropin_empty"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/sessionScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/sessionList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_8"
            android:paddingBottom="@dimen/space_6" />
    </ScrollView>

    <!-- Bottom Action Button (Tablet) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/createSession"
        style="@style/Widget.SmashNow.Button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="@dimen/space_8"
        android:layout_marginVertical="@dimen/space_4"
        android:minHeight="48dp"
        android:text="@string/owner_dropin_open_new" />
</LinearLayout>
