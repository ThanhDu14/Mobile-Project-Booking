<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="32dp">
        <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" />
        <EditText android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/owner_name" android:minHeight="48dp" />
        <EditText android:id="@+id/address" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/owner_address" android:minHeight="48dp" />
        <EditText android:id="@+id/openTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/owner_open_time" android:minHeight="48dp" />
        <EditText android:id="@+id/closeTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/owner_close_time" android:minHeight="48dp" />
        <EditText android:id="@+id/phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/owner_phone" android:minHeight="48dp" />
        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/recurring" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/owner_accepts_recurring" android:minHeight="48dp" />
        <TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/freshness" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" />
        <com.google.android.material.button.MaterialButton android:id="@+id/save" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/save" android:minHeight="48dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/owner_courts_title" android:textAppearance="?attr/textAppearanceTitleLarge" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/courts" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" />
        <EditText android:id="@+id/courtName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/owner_court_name" android:minHeight="48dp" />
        <EditText android:id="@+id/courtSurface" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/owner_court_surface" android:minHeight="48dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/addCourt" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/owner_court_add" android:minHeight="48dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/managePrices" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/owner_manage_prices" android:minHeight="48dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/blockSlots" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/owner_slot_block_title" android:minHeight="48dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/retry" android:minHeight="48dp" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
