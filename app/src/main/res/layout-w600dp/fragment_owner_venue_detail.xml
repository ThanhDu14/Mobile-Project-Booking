<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="?android:attr/colorBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="32dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginBottom="16dp">
            <ImageButton
            android:minWidth="@dimen/touch_min"
            android:minHeight="@dimen/touch_min" android:id="@+id/back" android:layout_width="@dimen/touch_min" android:layout_height="@dimen/touch_min" android:layout_marginStart="-12dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/owner_back" android:src="@drawable/ic_arrow_back_24" app:tint="?attr/colorOnSurface" />
            <TextView android:id="@+id/screenTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/owner_venue_info" android:textAppearance="?attr/textAppearanceHeadlineSmall" android:textStyle="bold" android:accessibilityHeading="true" />
        </LinearLayout>
        <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:visibility="gone" />
        <LinearLayout android:id="@+id/venueFields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <com.google.android.material.textfield.TextInputLayout style="@style/OwnerApplicationInput" android:hint="@string/owner_name">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/OwnerApplicationInput" android:hint="@string/owner_address" android:layout_marginTop="12dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/address" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPostalAddress" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/OwnerApplicationInput" android:hint="@string/owner_district" android:layout_marginTop="12dp" app:endIconMode="dropdown_menu">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/district" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:minHeight="@dimen/touch_min" android:paddingStart="@dimen/space_4" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/location" style="@style/Widget.SmashNow.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:text="@string/owner_map_location" android:layout_marginTop="12dp" app:icon="@drawable/ic_location_pin_24" />
            <include android:id="@+id/locationPreview" layout="@layout/view_owner_location_preview" />
            <com.google.android.material.textfield.TextInputLayout style="@style/OwnerApplicationInput" android:hint="@string/owner_phone" android:layout_marginTop="12dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone" />
            </com.google.android.material.textfield.TextInputLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
                <com.google.android.material.textfield.TextInputLayout style="@style/OwnerApplicationInput" android:layout_width="0dp" android:layout_weight="1" android:hint="@string/owner_open_time">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/openTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/OwnerApplicationInput" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="12dp" android:hint="@string/owner_close_time">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/closeTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <TextView style="@style/OwnerApplicationFieldLabel" android:text="@string/owner_amenities" />
            <com.google.android.material.chip.ChipGroup android:id="@+id/amenities" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView style="@style/OwnerApplicationFieldLabel" android:text="@string/owner_venue_photos" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:id="@+id/photos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
            </HorizontalScrollView>
            <com.google.android.material.button.MaterialButton android:id="@+id/addPhoto" style="@style/Widget.SmashNow.Button.Outlined" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/owner_add_photo" />
            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/recurring" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/owner_accepts_recurring" android:minHeight="56dp" />
            <TextView style="@style/OwnerApplicationFieldLabel" android:text="@string/owner_visibility" />
            <RadioGroup android:id="@+id/visibility" android:layout_width="match_parent" android:layout_height="wrap_content">
                <RadioButton android:id="@+id/active" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/owner_status_active" />
                <RadioButton android:id="@+id/hidden" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/owner_hidden_preserves_bookings" />
            </RadioGroup>
            <com.google.android.material.button.MaterialButton android:id="@+id/save" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/save" android:minHeight="48dp" />
            <!-- Tài khoản nhận tiền (spec 050): người chơi chuyển khoản tới đây; bản thử nghiệm chỉ giả lập tiền vào. -->
            <TextView android:id="@+id/payoutSectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_6" android:text="@string/owner_payout_title" android:textAppearance="?attr/textAppearanceTitleLarge" android:textStyle="bold" android:accessibilityHeading="true" />
            <TextView android:id="@+id/payoutStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textAppearance="?attr/textAppearanceBodyMedium" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/owner_payout_sandbox_note" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
            <com.google.android.material.textfield.TextInputLayout style="@style/OwnerApplicationInput" android:hint="@string/owner_payout_bank" android:layout_marginTop="12dp" app:endIconMode="dropdown_menu">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/payoutBank" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" android:minHeight="@dimen/touch_min" android:paddingStart="@dimen/space_4" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/OwnerApplicationInput" android:hint="@string/owner_payout_account_number" android:layout_marginTop="12dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/payoutAccountNumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="19" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/OwnerApplicationInput" android:hint="@string/owner_payout_holder" android:layout_marginTop="12dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/payoutHolder" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapCharacters|textNoSuggestions" android:maxLength="50" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/savePayout" style="@style/Widget.SmashNow.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/owner_payout_save" android:minHeight="48dp" />
        </LinearLayout>
        <TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" android:textColor="?attr/colorError" />
        <TextView android:id="@+id/freshness" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" android:textAppearance="?attr/textAppearanceBodySmall" />
        <LinearLayout android:id="@+id/courtFields" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="@dimen/space_2">
            <TextView android:id="@+id/courtsSectionTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/owner_courts_title" android:textAppearance="?attr/textAppearanceTitleLarge" android:textStyle="bold" />
            <androidx.recyclerview.widget.RecyclerView app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" android:id="@+id/courts" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" />
            <TextView style="@style/OwnerApplicationFieldLabel" android:text="@string/owner_court_add_section" />
            <com.google.android.material.textfield.TextInputLayout style="@style/OwnerApplicationInput" android:hint="@string/owner_court_name">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/courtName" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/OwnerApplicationInput" android:hint="@string/owner_court_surface" app:endIconMode="dropdown_menu">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/courtSurface" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/addCourt" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/owner_court_add" android:minHeight="48dp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/retry" android:minHeight="48dp" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
