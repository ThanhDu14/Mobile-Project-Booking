<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?android:attr/colorBackground" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/screen_gutter" android:paddingBottom="@dimen/space_4">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true" android:paddingTop="@dimen/space_4" android:text="@string/owner_voucher_create" android:textAppearance="?attr/textAppearanceHeadlineSmall" android:textColor="?attr/colorOnSurface" />
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_3" android:hint="@string/owner_voucher_code"><com.google.android.material.textfield.TextInputEditText android:id="@+id/code" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapCharacters" android:minHeight="48dp" android:singleLine="true" /></com.google.android.material.textfield.TextInputLayout>
        <Spinner android:id="@+id/type" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="@dimen/space_2" android:contentDescription="@string/owner_voucher_type" />
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/owner_voucher_value"><com.google.android.material.textfield.TextInputEditText android:id="@+id/value" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:minHeight="48dp" android:singleLine="true" /></com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/owner_voucher_max_discount"><com.google.android.material.textfield.TextInputEditText android:id="@+id/maxDiscount" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:minHeight="48dp" android:singleLine="true" /></com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/owner_voucher_min_order"><com.google.android.material.textfield.TextInputEditText android:id="@+id/minOrder" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:minHeight="48dp" android:singleLine="true" /></com.google.android.material.textfield.TextInputLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="@string/owner_voucher_valid_from"><com.google.android.material.textfield.TextInputEditText android:id="@+id/validFrom" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="date" android:minHeight="48dp" /></com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_2" android:layout_weight="1" android:hint="@string/owner_voucher_valid_to"><com.google.android.material.textfield.TextInputEditText android:id="@+id/validTo" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="date" android:minHeight="48dp" /></com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="@string/owner_voucher_usage_limit"><com.google.android.material.textfield.TextInputEditText android:id="@+id/usageLimit" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:minHeight="48dp" /></com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/space_2" android:layout_weight="1" android:hint="@string/owner_voucher_per_user"><com.google.android.material.textfield.TextInputEditText android:id="@+id/perUserLimit" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:minHeight="48dp" /></com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/isActive" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/owner_voucher_active" />
        <TextView android:id="@+id/validationText" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="@dimen/space_2" android:textColor="?attr/colorError" android:visibility="gone" />
        <TextView android:id="@+id/errorText" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="@dimen/space_2" android:textColor="?attr/colorError" android:visibility="gone" />
        <ProgressBar android:id="@+id/loading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/save" style="@style/Widget.SmashNow.Button" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="@dimen/space_3" android:text="@string/owner_voucher_save" />
    </LinearLayout>
</ScrollView>
