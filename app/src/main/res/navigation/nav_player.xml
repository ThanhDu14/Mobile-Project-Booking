<?xml version="1.0" encoding="utf-8"?>
<!-- Graph của người chơi; màn đầu là Trang chủ của spec 020. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_player"
    app:startDestination="@id/homeFragment">

    <!-- Trang chủ (spec 020 US5): danh sách mọi cơ sở đang hoạt động; bấm thẻ mở chi tiết sân (030). -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.booking_app.feature.search.ui.HomeFragment"
        android:label="@string/nav_tab_home">
        <action
            android:id="@+id/action_home_to_courtDetail"
            app:destination="@id/nav_court_detail" />
    </fragment>
    <fragment
        android:id="@+id/myBookingsFragment"
        android:name="com.example.booking_app.feature.booking_management.ui.MyBookingsFragment"
        android:label="@string/my_bookings_060_title">
        <deepLink app:uri="smashnow://bookings/mine" />
    </fragment>

    <!-- Lưới đặt sân (040): Trang chủ → chi tiết sân (030) → nút "Đặt sân". -->

    <fragment
        android:id="@+id/bookingSlotGridFragment"
        android:name="com.example.booking_app.feature.booking.ui.BookingSlotGridFragment"
        android:label="@string/booking_title">
        <argument
            android:name="venueId"
            app:argType="string"
            android:defaultValue="demo-truong-chinh-909" />
        <action
            android:id="@+id/action_bookingSlotGrid_to_bookingConfirm"
            app:destination="@id/bookingConfirmFragment" />
        <action
            android:id="@+id/action_bookingSlotGrid_to_recurringBooking"
            app:destination="@id/bookingRecurringConfigFragment" />
    </fragment>

    <fragment
        android:id="@+id/bookingConfirmFragment"
        android:name="com.example.booking_app.feature.booking.ui.BookingConfirmFragment"
        android:label="@string/booking_confirm_title">
        <argument
            android:name="args"
            app:argType="com.example.booking_app.feature.booking.ui.HoldToPaymentArgs" />
    </fragment>

    <fragment
        android:id="@+id/bookingRecurringConfigFragment"
        android:name="com.example.booking_app.feature.booking.ui.BookingRecurringConfigFragment"
        android:label="@string/recurring_title">
        <argument
            android:name="venueId"
            app:argType="string"
            android:defaultValue="demo-truong-chinh-909" />
        <action
            android:id="@+id/action_recurringConfig_to_recurringConfirm"
            app:destination="@id/bookingRecurringConfirmFragment" />
    </fragment>

    <fragment
        android:id="@+id/bookingRecurringConfirmFragment"
        android:name="com.example.booking_app.feature.booking.ui.BookingRecurringConfirmFragment"
        android:label="@string/recurring_confirm_title">
        <argument
            android:name="args"
            app:argType="com.example.booking_app.feature.booking.ui.HoldToPaymentArgs" />
    </fragment>

    <!-- Trang Tài khoản của spec 011 (research R14). Mở từ avatar ở header dùng chung của mọi tab (US8),
         qua AccountEntryNavigator; không còn tab Tài khoản. -->
    <include app:graph="@navigation/nav_account" />

    <action
        android:id="@+id/action_global_account"
        app:destination="@id/nav_account" />

    <include app:graph="@navigation/nav_review" />

    <!-- Chi tiết sân (spec 030): mở bằng deep link smashnow://venue/{venueId} hoặc action tới nav_court_detail. -->
    <include app:graph="@navigation/nav_court_detail" />

    <!-- Xem ảnh toàn màn hình dùng chung (core/ui/photo, spec 030 T019); 070 dùng cho ảnh đánh giá. -->
    <fragment
        android:id="@+id/photoViewerFragment"
        android:name="com.example.booking_app.core.ui.photo.PhotoViewerFragment"
        android:label="@string/court_detail_title">
        <argument
            android:name="photoUrls"
            app:argType="string[]" />
        <argument
            android:name="startIndex"
            app:argType="integer"
            android:defaultValue="0" />
    </fragment>

    <action
        android:id="@+id/action_global_photoViewer"
        app:destination="@id/photoViewerFragment" />

</navigation>
