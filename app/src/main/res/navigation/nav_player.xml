<?xml version="1.0" encoding="utf-8"?>
<!-- Placeholder của spec 010; spec sở hữu màn hình chính (020/060…) thay bằng màn hình thật. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_player"
    app:startDestination="@id/playerHomePlaceholderFragment">

    <fragment
        android:id="@+id/playerHomePlaceholderFragment"
        android:name="com.example.booking_app.feature.auth.ui.home.PlayerHomePlaceholderFragment"
        android:label="@string/app_name" />
    <!-- Lưới đặt sân (040) mở từ nút "Đặt sân" ở chi tiết sân (030) khi màn đó có; chưa có lối vào từ Trang chủ. -->

    <fragment
        android:id="@+id/bookingSlotGridFragment"
        android:name="com.example.booking_app.feature.booking.ui.BookingSlotGridFragment"
        android:label="@string/booking_title">
        <argument
            android:name="venueId"
            app:argType="string"
            android:defaultValue="demo-truong-chinh-909" />
        <action
            android:id="@+id/action_bookingSlotGrid_to_bookingConfirm"
            app:destination="@id/bookingConfirmFragment" />
    </fragment>

    <fragment
        android:id="@+id/bookingConfirmFragment"
        android:name="com.example.booking_app.feature.booking.ui.BookingConfirmFragment"
        android:label="@string/booking_confirm_title">
        <argument
            android:name="args"
            app:argType="com.example.booking_app.feature.booking.ui.HoldToPaymentArgs" />
    </fragment>

    <!-- Trang Tài khoản của spec 011 (research R14). -->
    <include app:graph="@navigation/nav_account" />

    <include app:graph="@navigation/nav_review" />

</navigation>
