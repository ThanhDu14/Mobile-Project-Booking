<?xml version="1.0" encoding="utf-8"?>
<!--
    Chi tiết sân (spec 030, contracts/navigation.md §1.1), include vào nav_player.
    Tham số giờ giống contract 020: date yyyyMMdd, startTime/endTime HHmm; thiếu hoặc sai thì coi như không có khung giờ.
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_court_detail"
    app:startDestination="@id/courtDetailFragment">

    <fragment
        android:id="@+id/courtDetailFragment"
        android:name="com.example.booking_app.feature.courtdetail.ui.CourtDetailFragment"
        android:label="@string/court_detail_title">
        <argument
            android:name="venueId"
            app:argType="string" />
        <argument
            android:name="date"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="startTime"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="endTime"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <deepLink app:uri="smashnow://venue/{venueId}?date={date}&amp;start={startTime}&amp;end={endTime}" />
        <!--
            Lưới đặt sân của 040 (ui-contracts §1.1). TODO(B): truyền date/startTime/endTime khi 040 có tham số
            (research R1); hiện bookingSlotGridFragment mới nhận venueId.
        -->
        <action
            android:id="@+id/action_courtDetail_to_bookingSlotGrid"
            app:destination="@id/bookingSlotGridFragment" />
    </fragment>

</navigation>
