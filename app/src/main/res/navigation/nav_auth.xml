<?xml version="1.0" encoding="utf-8"?>
<!--
    Đăng ký / đăng nhập (spec 010). Các user story thêm destination (login, register, otp...).
    Deep link mở nav_auth chồng lên màn hình hiện tại cho chế độ khách (research R15).
    Tạm gắn vào graph; US1 (T047) và US2 (T052) chuyển sang registerFragment, loginFragment.
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_auth"
    app:startDestination="@id/welcomeFragment">

    <argument
        android:name="returnTo"
        android:defaultValue="@null"
        app:argType="string"
        app:nullable="true" />

    <deepLink app:uri="smashnow://auth/login?returnTo={returnTo}" />
    <deepLink app:uri="smashnow://auth/register?returnTo={returnTo}" />

    <fragment
        android:id="@+id/welcomeFragment"
        android:name="com.example.booking_app.feature.auth.ui.welcome.WelcomeFragment"
        android:label="@string/app_name" />

</navigation>
