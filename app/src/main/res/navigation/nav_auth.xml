<?xml version="1.0" encoding="utf-8"?>
<!--
    Đăng ký / đăng nhập (spec 010). Deep link mở nav_auth chồng lên màn hình hiện tại cho chế độ khách
    (research R15).
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_auth"
    app:startDestination="@id/welcomeFragment">

    <argument
        android:name="returnTo"
        android:defaultValue="@null"
        app:argType="string"
        app:nullable="true" />

    <fragment
        android:id="@+id/welcomeFragment"
        android:name="com.example.booking_app.feature.auth.ui.welcome.WelcomeFragment"
        android:label="@string/app_name">
        <action
            android:id="@+id/action_welcome_to_login"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_welcome_to_register"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.booking_app.feature.auth.ui.login.LoginFragment"
        android:label="@string/auth_login_title">
        <!-- URI deep link để mở lại sau khi đăng nhập (FR-026). MainActivity đọc từ back stack entry. -->
        <argument
            android:name="returnTo"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="lockedNotice"
            android:defaultValue="false"
            app:argType="boolean" />
        <!-- Điền sẵn email khi đi từ lỗi "Email đã được sử dụng" (US1-3). LoginViewModel đọc qua SavedStateHandle. -->
        <argument
            android:name="email"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <deepLink app:uri="smashnow://auth/login?returnTo={returnTo}&amp;lockedNotice={lockedNotice}" />
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_login_to_forgot"
            app:destination="@id/forgotPasswordFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.booking_app.feature.auth.ui.register.RegisterFragment"
        android:label="@string/auth_register_title">
        <argument
            android:name="returnTo"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <deepLink app:uri="smashnow://auth/register?returnTo={returnTo}" />
        <action
            android:id="@+id/action_register_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_register_to_forgot"
            app:destination="@id/forgotPasswordFragment" />
    </fragment>

    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="com.example.booking_app.feature.auth.ui.forgot.ForgotPasswordFragment"
        android:label="@string/auth_forgot_title">
        <!-- Điền sẵn từ màn hình đăng nhập hoặc lỗi "Email đã được sử dụng" ở màn hình đăng ký. -->
        <argument
            android:name="email"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <action
            android:id="@+id/action_forgot_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Initializing / InitFailed (FR-006). MainActivity mở bằng deep link, xóa back stack. -->
    <fragment
        android:id="@+id/accountSetupFragment"
        android:name="com.example.booking_app.feature.auth.ui.setup.AccountSetupFragment"
        android:label="@string/auth_setup_loading">
        <deepLink app:uri="smashnow://auth/setup" />
    </fragment>

    <!-- Google/OTP lần đầu (SessionState.NeedsConsent). MainActivity mở bằng deep link khi nav_auth chưa có. -->
    <fragment
        android:id="@+id/termsConsentFragment"
        android:name="com.example.booking_app.feature.auth.ui.consent.TermsConsentFragment"
        android:label="@string/auth_consent_title">
        <deepLink app:uri="smashnow://auth/consent" />
    </fragment>

    <fragment
        android:id="@+id/legalDocumentFragment"
        android:name="com.example.booking_app.feature.auth.ui.legal.LegalDocumentFragment"
        android:label="@string/auth_legal_terms_title">
        <argument
            android:name="doc"
            android:defaultValue="TERMS"
            app:argType="string" />
    </fragment>

</navigation>
