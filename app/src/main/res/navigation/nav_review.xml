<?xml version="1.0" encoding="utf-8"?>
<!--
    Nav graph lồng của spec 070 phía người chơi (contracts/ui-screens.md §1), được include vào nav_player:
    "Sân yêu thích" (US3), "Viết/sửa đánh giá" (US1, US2, US5), "Tất cả đánh giá" (US6), xem ảnh (US2).
    Màn "Đánh giá của khách" của chủ sân (US4) nằm ở nav_review_owner (include vào nav_owner).
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_review"
    app:startDestination="@id/favoriteVenuesFragment">

    <fragment
        android:id="@+id/favoriteVenuesFragment"
        android:name="com.example.booking_app.feature.review.ui.favorite.FavoriteVenuesFragment"
        android:label="@string/favorite_title">
        <!-- Mục "Sân yêu thích" trên trang Tài khoản (spec 011, AccountEntry.FAVORITES) mở bằng deep link này. -->
        <deepLink app:uri="smashnow://favorites" />
        <!-- Tạm mở lưới đặt sân (spec 040) cho đến khi có chi tiết sân (spec 030). -->
        <action
            android:id="@+id/action_favoriteVenues_to_bookingSlotGrid"
            app:destination="@id/bookingSlotGridFragment" />
    </fragment>

    <!--
        Viết / xem đánh giá của một đơn (US1). Chi tiết đơn (spec 060) mở bằng
        app:destination="@id/writeReviewFragment" hoặc deep link; thông báo REVIEW_REMINDER (spec 100) dùng deep link.
    -->
    <fragment
        android:id="@+id/writeReviewFragment"
        android:name="com.example.booking_app.feature.review.ui.write.WriteReviewFragment"
        android:label="@string/review_write_title">
        <!-- Đúng một trong bookingId (đơn đặt sân) và sessionId (buổi vãng lai, spec 080 US5). -->
        <argument
            android:name="bookingId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="sessionId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="mode"
            android:defaultValue="CREATE"
            app:argType="com.example.booking_app.feature.review.ui.write.WriteReviewMode" />
        <deepLink app:uri="smashnow://review/write/{bookingId}" />
    </fragment>

    <!--
        Tất cả đánh giá của một sân (US6). Nút "Xem tất cả" ở chi tiết sân (spec 030) mở bằng
        app:destination="@id/venueReviewsFragment"; thông báo REVIEW_REPLY (spec 100) dùng deep link.
    -->
    <fragment
        android:id="@+id/venueReviewsFragment"
        android:name="com.example.booking_app.feature.review.ui.list.VenueReviewsFragment"
        android:label="@string/review_list_title">
        <argument
            android:name="venueId"
            app:argType="string" />
        <argument
            android:name="venueName"
            android:defaultValue=""
            app:argType="string" />
        <deepLink app:uri="smashnow://review/venue/{venueId}" />
    </fragment>

    <!-- Xem ảnh đánh giá (US2, T046), mở từ lưới ảnh của item_review. -->
    <fragment
        android:id="@+id/reviewPhotoViewerFragment"
        android:name="com.example.booking_app.feature.review.ui.photo.PhotoViewerFragment"
        android:label="@string/review_photos_label">
        <argument
            android:name="photoUrls"
            app:argType="string[]" />
        <argument
            android:name="startIndex"
            android:defaultValue="0"
            app:argType="integer" />
    </fragment>

</navigation>
