<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_owner"
    app:startDestination="@id/ownerHomePlaceholderFragment">

    <fragment
        android:id="@+id/ownerVenueListFragment"
        android:name="com.example.booking_app.feature.owner.ui.OwnerVenueListFragment"
        android:label="@string/owner_venues_title">
        <!-- Mục "Cơ sở của tôi" trên trang Tài khoản (spec 011, OwnerLink.VENUES) mở bằng deep link này. -->
        <deepLink app:uri="smashnow://owner/venues" />
        <action
            android:id="@+id/action_ownerVenueList_to_detail"
            app:destination="@id/ownerVenueDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/ownerVenueDetailFragment"
        android:name="com.example.booking_app.feature.owner.ui.OwnerVenueDetailFragment"
        android:label="@string/owner_name">
        <argument android:name="venueId" app:argType="string" />
        <action android:id="@+id/action_ownerVenueDetail_to_slotBlock" app:destination="@id/ownerSlotBlockFragment" />
        <action android:id="@+id/action_ownerVenueDetail_to_priceRule" app:destination="@id/ownerPriceRuleFragment" />
    </fragment>

    <fragment android:id="@+id/ownerSlotBlockFragment" android:name="com.example.booking_app.feature.owner.ui.OwnerSlotBlockFragment" android:label="@string/owner_slot_block_title">
        <argument android:name="venueId" app:argType="string" />
        <argument android:name="courtId" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/ownerPriceRuleFragment"
        android:name="com.example.booking_app.feature.owner.ui.OwnerPriceRuleFragment"
        android:label="@string/owner_prices_title">
        <argument android:name="venueId" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/ownerCalendarFragment"
        android:name="com.example.booking_app.feature.owner.ui.calendar.OwnerCalendarFragment"
        android:label="@string/owner_calendar_title" />

    <fragment
        android:id="@+id/ownerBookingsFragment"
        android:name="com.example.booking_app.feature.owner.ui.bookings.OwnerBookingsFragment"
        android:label="@string/owner_bookings_title">
        <action android:id="@+id/action_ownerBookings_to_checkin" app:destination="@id/ownerBookingCheckInFragment" />
    </fragment>

    <fragment
        android:id="@+id/ownerBookingCheckInFragment"
        android:name="com.example.booking_app.feature.owner.ui.bookings.OwnerBookingCheckInFragment"
        android:label="@string/owner_booking_checkin_title" />

    <fragment android:id="@+id/ownerDropInFragment" android:name="com.example.booking_app.feature.owner.ui.dropin.OwnerDropInFragment" android:label="@string/owner_dropin_title">
        <action android:id="@+id/action_ownerDropIn_to_form" app:destination="@id/ownerDropInFormFragment" />
        <action android:id="@+id/action_ownerDropIn_to_roster" app:destination="@id/ownerDropInRosterFragment" />
    </fragment>
    <fragment android:id="@+id/ownerDropInFormFragment" android:name="com.example.booking_app.feature.owner.ui.dropin.OwnerDropInFormFragment" android:label="@string/owner_dropin_create" />
    <fragment android:id="@+id/ownerDropInRosterFragment" android:name="com.example.booking_app.feature.owner.ui.dropin.OwnerDropInRosterFragment" android:label="@string/owner_dropin_roster">
        <argument android:name="venueId" app:argType="string" />
        <argument android:name="sessionId" app:argType="string" />
    </fragment>

    <fragment android:id="@+id/ownerVouchersFragment" android:name="com.example.booking_app.feature.owner.ui.vouchers.OwnerVouchersFragment" android:label="@string/owner_voucher_title">
        <action android:id="@+id/action_ownerVouchers_to_form" app:destination="@id/ownerVoucherFormFragment" />
    </fragment>
    <fragment android:id="@+id/ownerVoucherFormFragment" android:name="com.example.booking_app.feature.owner.ui.vouchers.OwnerVoucherFormFragment" android:label="@string/owner_voucher_create">
        <argument android:name="venueId" app:argType="string" />
    </fragment>

    <fragment android:id="@+id/ownerStatisticsFragment" android:name="com.example.booking_app.feature.owner.ui.statistics.OwnerStatisticsFragment" android:label="@string/owner_statistics_title" />

    <!-- Tab Hôm nay của OwnerNav, entry point của Feature 112. -->
    <fragment
        android:id="@+id/ownerHomePlaceholderFragment"
        android:name="com.example.booking_app.feature.auth.ui.home.OwnerHomePlaceholderFragment"
        android:label="@string/app_name">
        <action
            android:id="@+id/action_ownerHome_to_account"
            app:destination="@id/nav_account" />
    </fragment>

    <!-- Trang Tài khoản của spec 011 (research R14). -->
    <include app:graph="@navigation/nav_account" />

</navigation>
