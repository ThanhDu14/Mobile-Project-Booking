<?xml version="1.0" encoding="utf-8"?>
<!-- Nhập mã OTP theo wireframe buoc5_nhap-otp-sai-ma (US5, FR-016). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/auth_form_max_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_gutter"
            android:paddingBottom="@dimen/space_4">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:layout_marginStart="-12dp"
                android:layout_marginTop="@dimen/space_2"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/auth_back"
                android:src="@drawable/ic_arrow_back_24"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:accessibilityHeading="true"
                android:text="@string/auth_otp_title"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/changeNumberButton"
                    style="@style/Widget.SmashNow.Button.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_otp_change_number" />
            </LinearLayout>

            <!--
                Nhãn TalkBack "Chữ số thứ N của mã" đặt trong OtpVerifyFragment (auth_otp_digit_description).
                Ô đầu nhận autofill mã SMS; dán/điền cả mã thì Fragment chia ra 6 ô.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/digit1"
                    style="@style/Widget.SmashNow.OtpDigit"
                    android:autofillHints="smsOTPCode"
                    tools:ignore="LabelFor" />
                <EditText
                    android:id="@+id/digit2"
                    style="@style/Widget.SmashNow.OtpDigit"
                    android:importantForAutofill="no"
                    tools:ignore="LabelFor"
                    android:layout_marginStart="@dimen/space_2" />
                <EditText
                    android:id="@+id/digit3"
                    style="@style/Widget.SmashNow.OtpDigit"
                    android:importantForAutofill="no"
                    tools:ignore="LabelFor"
                    android:layout_marginStart="@dimen/space_2" />
                <EditText
                    android:id="@+id/digit4"
                    style="@style/Widget.SmashNow.OtpDigit"
                    android:importantForAutofill="no"
                    tools:ignore="LabelFor"
                    android:layout_marginStart="@dimen/space_2" />
                <EditText
                    android:id="@+id/digit5"
                    style="@style/Widget.SmashNow.OtpDigit"
                    android:importantForAutofill="no"
                    tools:ignore="LabelFor"
                    android:layout_marginStart="@dimen/space_2" />
                <EditText
                    android:id="@+id/digit6"
                    style="@style/Widget.SmashNow.OtpDigit"
                    android:importantForAutofill="no"
                    tools:ignore="LabelFor"
                    android:layout_marginStart="@dimen/space_2" />
            </LinearLayout>

            <TextView
                android:id="@+id/errorText"
                style="@style/Widget.SmashNow.FormError"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/submitButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="@string/auth_otp_submit" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/submitProgress"
                    style="@style/Widget.SmashNow.ButtonProgress"
                    android:visibility="gone" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_3">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resendButton"
                    style="@style/Widget.SmashNow.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_otp_resend"
                    app:icon="@drawable/ic_timer_24"
                    app:iconGravity="textStart" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/resendProgress"
                    style="@style/Widget.SmashNow.ButtonProgress.OnSurface"
                    android:visibility="gone" />
            </FrameLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="@dimen/space_6" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/auth_otp_footer"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
