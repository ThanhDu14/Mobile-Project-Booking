<?xml version="1.0" encoding="utf-8"?>
<!--
    Thêm người vào lượt đã đăng ký (spec 080 FR-008a). Mở từ màn hình vé, không phải destination của nav graph.
    Chọn 1..maxAdditional người, hiện số tiền phải trả thêm, lỗi và nút xác nhận/thử lại.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_gutter"
    android:paddingTop="@dimen/space_4"
    android:paddingBottom="@dimen/space_6">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="@string/dropin_add_party_title"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/addPartyHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Bạn đang có 2 người. Thêm được tối đa 2 người nữa (mỗi lượt tối đa 4 người)." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/dropin_confirm_party"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addPartyDecrease"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:contentDescription="@string/dropin_confirm_party_decrease"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="@dimen/touch_min"
            android:minHeight="@dimen/touch_min"
            android:padding="0dp"
            android:text="@string/dropin_add_party_minus"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <TextView
            android:id="@+id/addPartyValue"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface"
            tools:text="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addPartyIncrease"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:contentDescription="@string/dropin_confirm_party_increase"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="@dimen/touch_min"
            android:minHeight="@dimen/touch_min"
            android:padding="0dp"
            android:text="@string/dropin_add_party_plus"
            android:textAppearance="?attr/textAppearanceTitleLarge" />
    </LinearLayout>

    <!-- Phải trả thêm: giá × số người thêm = tổng -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:background="@drawable/bg_info_box"
        android:orientation="vertical"
        android:padding="@dimen/space_4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dropin_add_party_extra_label"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/addPartyAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorPrimary"
                tools:text="60.000 đ" />
        </LinearLayout>

        <TextView
            android:id="@+id/addPartyBreakdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="60.000 đ × 1 người" />

        <TextView
            android:id="@+id/addPartyPaymentNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="@string/dropin_add_party_pay_mock" />
    </LinearLayout>

    <TextView
        android:id="@+id/addPartyError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:accessibilityLiveRegion="assertive"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorError"
        android:visibility="gone"
        tools:text="@string/dropin_add_party_error_network"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/addPartySubmit"
        style="@style/Widget.SmashNow.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:minHeight="@dimen/touch_min"
        tools:text="Thêm 1 người" />
</LinearLayout>
