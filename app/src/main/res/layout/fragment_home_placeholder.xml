<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_gutter">

    <!-- Chỉ hiện với tài khoản mật khẩu chưa xác minh email (FR-009). -->
    <com.example.booking_app.core.ui.VerifyEmailBannerView
        android:id="@+id/verifyEmailBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:visibility="gone"
        tools:visibility="visible" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface"
        tools:text="@string/auth_home_placeholder_player" />

    <!-- Nút điều hướng tạm sang Feature 040 để kiểm thử -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGoToBooking"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/space_4"
        android:text="Đặt sân theo giờ (Feature 040)"
        android:textAppearance="@style/TextAppearance.SmashNow.Label"
        app:cornerRadius="26dp"
        app:icon="@drawable/ic_calendar_24"
        app:iconGravity="textStart"
        app:iconPadding="8dp" />

    <TextView
        android:id="@+id/guestNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:text="@string/auth_home_guest_note"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Lối vào trang Tài khoản (spec 011) tới khi có thanh điều hướng dưới của 020/111. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/accountButton"
        style="@style/Widget.SmashNow.Button.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:text="@string/account_title"
        android:visibility="gone"
        app:icon="@drawable/ic_account_circle_24"
        app:iconTint="?attr/colorOnSurface"
        tools:visibility="visible" />

    <com.example.booking_app.core.ui.LoginPromptView
        android:id="@+id/loginPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:maxWidth="@dimen/auth_form_max_width"
        android:visibility="gone"
        tools:visibility="visible" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
