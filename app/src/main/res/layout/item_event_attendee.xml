<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/touch_min"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/space_2">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/attendeeAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/colorSurfaceVariant"
        android:scaleType="centerCrop"
        app:shapeAppearance="@style/ShapeAppearance.SmashNow.Medium"
        tools:src="@drawable/ic_person_outline_24" />

    <TextView
        android:id="@+id/attendeeName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_3"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurface"
        tools:text="Nguyễn Văn A" />
</LinearLayout>
