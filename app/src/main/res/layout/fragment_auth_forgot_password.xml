<?xml version="1.0" encoding="utf-8"?>
<!-- Quên mật khẩu theo wireframe buoc7_quen-mat-khau (US3, FR-018). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/auth_form_max_width">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_gutter"
            android:paddingBottom="@dimen/space_4">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:layout_marginStart="-12dp"
                android:layout_marginTop="@dimen/space_2"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/auth_back"
                android:src="@drawable/ic_arrow_back_24"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:accessibilityHeading="true"
                android:text="@string/auth_forgot_title"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/auth_forgot_subtitle"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                style="@style/Widget.SmashNow.FieldLabel"
                android:labelFor="@id/emailInput"
                android:text="@string/auth_field_email" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/emailLayout"
                style="@style/Widget.SmashNow.TextInputLayout"
                app:placeholderText="@string/auth_field_email_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/emailInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="emailAddress"
                    android:imeOptions="actionSend"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <FrameLayout
                android:id="@+id/submitContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_6">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/submitButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_forgot_submit" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/submitProgress"
                    style="@style/Widget.SmashNow.ButtonProgress"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Đã gửi: cùng một thông báo dù email có tài khoản hay không (FR-018) -->
            <LinearLayout
                android:id="@+id/sentGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:accessibilityLiveRegion="polite"
                    android:background="@drawable/bg_success_box"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_4">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_mail_24"
                        app:tint="@color/sn_on_court_container" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_4"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/auth_forgot_sent_title"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/sn_on_court_container" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_1"
                            android:text="@string/auth_forgot_sent_body"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="@color/sn_on_court_container" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/Widget.SmashNow.CheckRow"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/auth_forgot_spam_tip" />

                <TextView
                    style="@style/Widget.SmashNow.CheckRow"
                    android:text="@string/auth_forgot_password_tip" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/resendButton"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/auth_forgot_resend" />

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/resendProgress"
                        style="@style/Widget.SmashNow.ButtonProgress.OnSurface"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="@dimen/space_6" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backToLoginButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auth_forgot_back_to_login"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
