<?xml version="1.0" encoding="utf-8"?>
<!--
    Một đánh giá (spec 070 T017): avatar, tên, điểm tổng + 3 tiêu chí, bình luận, lưới ảnh, ngày,
    nhãn "Đã chỉnh sửa", nhãn "Đánh giá đã bị ẩn", khối "Phản hồi của chủ sân". Dùng ở US6 và US4.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/screen_gutter"
    android:paddingVertical="@dimen/space_3">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/colorSurfaceContainerHigh"
            android:padding="0dp"
            android:scaleType="centerCrop"
            app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full"
            tools:src="@drawable/ic_person_outline_24" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/authorName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface"
                tools:text="Nguyễn Văn A" />

            <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="04/10/2026 · Đã chỉnh sửa" />
        </LinearLayout>

        <TextView
            android:id="@+id/overall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/space_1"
            android:gravity="center_vertical"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            app:drawableStartCompat="@drawable/ic_star_16"
            app:drawableTint="@color/sn_lamp"
            tools:text="4,0" />
    </LinearLayout>

    <TextView
        android:id="@+id/venueLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorPrimary"
        android:visibility="gone"
        tools:text="Sân Phú Thọ"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/dropInLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:background="@drawable/bg_info_box"
        android:paddingHorizontal="@dimen/space_2"
        android:paddingVertical="2dp"
        android:text="@string/review_label_drop_in"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/criteria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Sân 5 · Vệ sinh 4 · Phục vụ 3" />

    <TextView
        android:id="@+id/hiddenLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:background="@drawable/bg_info_box"
        android:paddingHorizontal="@dimen/space_2"
        android:paddingVertical="2dp"
        android:text="@string/review_hidden_label"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <TextView
        android:id="@+id/comment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurface"
        tools:text="Sân sạch, đèn sáng, nhân viên nhiệt tình." />

    <LinearLayout
        android:id="@+id/photos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/photo1"
            style="@style/Widget.SmashNow.ReviewPhotoThumb" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/photo2"
            style="@style/Widget.SmashNow.ReviewPhotoThumb" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/photo3"
            style="@style/Widget.SmashNow.ReviewPhotoThumb" />
    </LinearLayout>

    <!-- Phản hồi của chủ sân -->
    <LinearLayout
        android:id="@+id/replyBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:background="@drawable/bg_info_box"
        android:orientation="vertical"
        android:padding="@dimen/space_3"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/replyLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/review_owner_reply_label"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/replyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Cảm ơn bạn đã ủng hộ sân!" />
    </LinearLayout>

    <!-- Nút cho chủ sân (US4) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/replyButton"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="@dimen/space_2"
        android:minHeight="48dp"
        android:visibility="gone"
        tools:text="@string/review_reply"
        tools:visibility="visible" />
</LinearLayout>
