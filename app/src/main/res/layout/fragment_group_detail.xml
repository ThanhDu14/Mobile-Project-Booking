<?xml version="1.0" encoding="utf-8"?>
<!--
    Trang nhóm (spec 090 US1–US3, T029 + T038 + T050; wireframe 09_community-chat_buoc2_bang-tin-nhom.png).
    Người ngoài chỉ thấy giới thiệu + nút tham gia; thành viên thấy thêm nút Chat nhóm, Thành viên, thanh đăng bài
    và bảng tin (có đủ 4 trạng thái qua feedStateViews).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/community_back"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:title="@string/community_title_group_detail"
        app:titleTextAppearance="?attr/textAppearanceTitleLarge" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/screen_gutter"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/groupAvatar"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="?attr/colorSurfaceVariant"
                        android:scaleType="centerCrop"
                        app:shapeAppearance="@style/ShapeAppearance.SmashNow.Medium"
                        tools:src="@drawable/ic_groups_24" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/groupName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceTitleLarge"
                            android:textColor="?attr/colorOnSurface"
                            tools:text="CLB Cầu lông Quận 10" />

                        <TextView
                            android:id="@+id/groupMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="Công khai · 48 thành viên" />

                        <TextView
                            android:id="@+id/groupDistrict"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="Khu vực: Quận 10" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/lockedLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:background="@drawable/bg_info_box"
                    android:padding="@dimen/space_3"
                    android:text="@string/community_label_group_locked"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorError"
                    android:visibility="gone" />

                <!-- Thành viên: Chat nhóm + Thành viên (wireframe bước 2) -->
                <LinearLayout
                    android:id="@+id/memberActionsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chatButton"
                        style="@style/Widget.SmashNow.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_2"
                        android:layout_weight="1"
                        android:minHeight="@dimen/touch_min"
                        android:text="@string/community_action_chat"
                        app:icon="@drawable/ic_chat_24" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/membersButton"
                        style="@style/Widget.SmashNow.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="@dimen/touch_min"
                        android:text="@string/community_action_members"
                        app:icon="@drawable/ic_groups_24" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editButton"
                    style="@style/Widget.SmashNow.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:minHeight="@dimen/touch_min"
                    android:text="@string/community_action_edit_group"
                    android:visibility="gone"
                    app:icon="@drawable/ic_edit_24"
                    tools:visibility="visible" />

                <!-- US2: Tham gia / Xin tham gia / Đang chờ duyệt + Hủy yêu cầu / Rời nhóm / Yêu cầu tham gia (N) -->
                <LinearLayout
                    android:id="@+id/joinArea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/joinButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_min"
                        android:text="@string/community_action_join"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/pendingNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_info_box"
                        android:padding="@dimen/space_3"
                        android:text="@string/community_join_pending_note"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cancelRequestButton"
                        style="@style/Widget.SmashNow.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:minHeight="@dimen/touch_min"
                        android:text="@string/community_action_cancel_request"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/requestsButton"
                        style="@style/Widget.SmashNow.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_min"
                        android:text="@string/community_title_join_requests"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/leaveButton"
                        style="@style/Widget.SmashNow.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:minHeight="@dimen/touch_min"
                        android:text="@string/community_action_leave"
                        android:textColor="?attr/colorError"
                        android:visibility="gone"
                        app:strokeColor="?attr/colorError" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:text="@string/community_detail_about"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/groupDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Chơi tối thứ 6 tại sân Quận 10" />

                <!-- US3: bảng tin của nhóm (chỉ hiện với thành viên, AC 3.7) -->
                <LinearLayout
                    android:id="@+id/feedArea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <!-- Thanh soạn bài / tạo sự kiện (ẩn khi nhóm LOCKED) -->
                    <LinearLayout
                        android:id="@+id/composerBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_3"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/newPostButton"
                            style="@style/Widget.SmashNow.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="@dimen/touch_min"
                            android:text="@string/community_action_new_post"
                            app:icon="@drawable/ic_edit_24" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/newEventButton"
                            style="@style/Widget.SmashNow.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_2"
                            android:layout_weight="1"
                            android:minHeight="@dimen/touch_min"
                            android:text="@string/community_action_new_event"
                            app:icon="@drawable/ic_event_24" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="180dp">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/feedList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <include
                            android:id="@+id/feedStateViews"
                            layout="@layout/include_state_views" />
                    </FrameLayout>

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/feedLoadMoreProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginVertical="@dimen/space_3"
                        android:contentDescription="@string/community_feed_loading_more_cd"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorSize="28dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/feedLoadMoreRetry"
                        style="@style/Widget.SmashNow.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_min"
                        android:text="@string/community_feed_load_more_failed"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/feedFooterNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:gravity="center"
                        android:text="@string/community_feed_no_comments_note"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/stateViews"
            layout="@layout/include_state_views" />
    </FrameLayout>
</LinearLayout>
