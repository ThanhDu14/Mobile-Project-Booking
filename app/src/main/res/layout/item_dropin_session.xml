<?xml version="1.0" encoding="utf-8"?>
<!--
    Thẻ một buổi vãng lai (FR-002): ngày, giờ bắt đầu–kết thúc, tên cơ sở · quận, trình độ, "Còn X/Y chỗ",
    giá mỗi lượt, nhãn "Đã đủ người". Màu theo theme.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="?attr/materialCardViewOutlinedStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_3"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/radius_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_4">

        <!-- Ô ngày: thứ, ngày, "Hôm nay"/"Mai" -->
        <LinearLayout
            android:id="@+id/dateBox"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_info_box"
            android:backgroundTint="?attr/colorSurfaceVariant"
            android:gravity="center_horizontal"
            android:importantForAccessibility="no"
            android:orientation="vertical"
            android:paddingVertical="@dimen/space_2">

            <TextView
                android:id="@+id/dayOfWeek"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="T3" />

            <TextView
                android:id="@+id/dayOfMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorOnSurface"
                tools:text="06" />

            <TextView
                android:id="@+id/relativeDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="Mai"
                tools:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:orientation="vertical">

            <TextView
                android:id="@+id/timeRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="19:00 – 21:00" />

            <TextView
                android:id="@+id/venueDistrict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface"
                tools:text="Sân cầu lông Hòa Bình · Quận 10" />

            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                app:chipSpacingVertical="0dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/levelChip"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    tools:text="Trung bình" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/fullChip"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:text="@string/dropin_label_full"
                    android:textColor="?attr/colorOnTertiaryContainer"
                    android:visibility="gone"
                    app:chipBackgroundColor="?attr/colorTertiaryContainer"
                    app:chipStrokeWidth="0dp"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:minHeight="@dimen/touch_min"
                    android:gravity="center_vertical"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Còn 3/12 chỗ" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:gravity="end"
            android:importantForAccessibility="no"
            android:orientation="vertical">

            <TextView
                android:id="@+id/price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="60.000 đ" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dropin_per_turn"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
