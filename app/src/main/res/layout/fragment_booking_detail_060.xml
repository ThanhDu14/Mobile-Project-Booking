<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- Topbar matching Mockup 2 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/buttonBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/my_bookings_060_back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="?attr/colorOnBackground" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/buttonBack"
            android:layout_marginStart="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textDetailTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_bookings_060_detail_title"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textBookingSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@color/sn_ink_muted" />
        </LinearLayout>

        <ImageView
            android:id="@+id/buttonTopReceipt"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/my_bookings_060_receipt"
            android:padding="12dp"
            android:src="@drawable/ic_description_24"
            app:tint="?attr/colorOnBackground" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- Card QR Center per Mockup 2 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/sn_line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_confirmed"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="6dp"
                            android:src="@drawable/ic_check_20"
                            app:tint="@color/sn_on_court_container" />

                        <TextView
                            android:id="@+id/textDetailStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/my_bookings_060_badge_confirmed"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="@color/sn_on_court_container"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/imageBookingQr"
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        android:layout_marginTop="16dp"
                        android:background="@android:color/white"
                        android:contentDescription="@string/my_bookings_060_qr_description"
                        android:padding="8dp" />

                    <TextView
                        android:id="@+id/textQrCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:letterSpacing="0.1"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textQrInstructions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/sn_ink_muted" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonIncreaseBrightness"
                        style="@style/Widget.SmashNow.Button.Link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="40dp"
                        android:text="@string/my_bookings_060_brightness"
                        android:textColor="@color/sn_court"
                        app:icon="@drawable/ic_flash_on_24"
                        app:iconSize="18dp"
                        app:iconTint="@color/sn_court" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Checked-In per Mockup 2 (Check-in) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCheckedIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/sn_court_container"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_person_outline_24"
                        app:tint="@color/sn_on_court_container" />

                    <TextView
                        android:id="@+id/textCheckedInTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="@color/sn_on_court_container"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textCheckedInMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/sn_on_court_container" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Venue Info Section -->
            <TextView
                android:id="@+id/textDetailVenue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorOnBackground"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textDetailTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnBackground"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textDetailCourt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/sn_ink_muted" />

            <TextView
                android:id="@+id/textDetailAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/sn_ink_muted" />

            <TextView
                android:id="@+id/textDetailPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/sn_ink_muted"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textRecurringGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/sn_court"
                android:visibility="gone" />

            <!-- Horizontal Action Buttons: Directions & Call -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonDirections"
                    style="@style/Widget.SmashNow.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="10dp"
                    android:minHeight="40dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="0dp"
                    android:text="@string/my_bookings_060_directions"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    app:cornerRadius="20dp"
                    app:icon="@drawable/ic_directions_24"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonCallVenue"
                    style="@style/Widget.SmashNow.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minHeight="40dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="0dp"
                    android:text="@string/my_bookings_060_call"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    app:cornerRadius="20dp"
                    app:icon="@drawable/ic_call_24"
                    app:iconSize="18dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textBookingSlots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/sn_ink_muted"
                android:visibility="gone" />

            <!-- Payment Breakdown Card per Mockup 2 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/sn_line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/textPaymentTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/my_bookings_060_payment_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textStyle="bold" />

                    <!-- Subtotal row -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:id="@+id/labelSubtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:text="Tiền sân"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/sn_ink" />

                        <TextView
                            android:id="@+id/textSubtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/sn_ink" />
                    </RelativeLayout>

                    <!-- Paid / Deposit row -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:id="@+id/labelPaidAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:text="Đã đặt cọc (ví giả lập)"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/sn_ink" />

                        <TextView
                            android:id="@+id/textPaidAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/sn_ink" />
                    </RelativeLayout>

                    <!-- Discount voucher row (if any) -->
                    <RelativeLayout
                        android:id="@+id/rowDiscount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:text="Voucher giảm giá"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/sn_ink" />

                        <TextView
                            android:id="@+id/textDiscount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/sn_court" />
                    </RelativeLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="@color/sn_line" />

                    <!-- Remaining row -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:text="Còn trả tại sân"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textRemainingAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:textAppearance="?attr/textAppearanceTitleLarge"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/textPaymentMethod"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/textCreatedAt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <!-- View Receipt Link -->
                    <TextView
                        android:id="@+id/buttonReceipt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingVertical="4dp"
                        android:text="@string/my_bookings_060_receipt"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="@color/sn_court"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Policy Warning Box per Mockup 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_pill_confirmed"
                android:backgroundTint="@color/sn_surface_sunken"
                android:gravity="top"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_info_24"
                    app:tint="@color/sn_ink_muted" />

                <TextView
                    android:id="@+id/textCancellationPolicy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:lineSpacingExtra="3dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/sn_ink" />
            </LinearLayout>

            <!-- Cancel Button Centered in Red Text per Mockup 2 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCancelBooking"
                style="@style/Widget.SmashNow.Button.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:minHeight="48dp"
                android:text="@string/my_bookings_060_cancel_booking"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/sn_danger"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
