<?xml version="1.0" encoding="utf-8"?>
<!--
    Lượt chờ của tôi ở một buổi vãng lai (spec 081 US1, US3, US4, T024; wireframe ui/08_drop-in_buoc1_hang-cho.png).
    waitingGroup: vị trí N / tổng (thông báo cho TalkBack khi đổi), thông tin buổi, số người, cách thanh toán, số tiền sẽ ghi
    nhận (chưa trừ gì, FR-002). endedGroup: kết quả cuối khi đã rời hoặc hàng chờ đóng (không crash) kèm "Tìm buổi khác".
    Thanh dưới: nút "Rời hàng chờ" viền đỏ (chỉ hiện khi đang chờ). include_state_views chồng lên vùng nội dung cho
    loading, không có lượt chờ, lỗi (FR-024). Màu theo theme nên chế độ tối dùng màu theme; bản w600dp ở layout-w600dp.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/dropin_back"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:title="@string/dropin_waitlist_entry_title"
        app:titleTextAppearance="?attr/textAppearanceTitleLarge" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_gutter"
                android:paddingTop="@dimen/space_2"
                android:paddingBottom="@dimen/space_6">

                <LinearLayout
                    android:id="@+id/waitingGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Vị trí trong hàng chờ -->
                    <com.google.android.material.card.MaterialCardView
                        style="?attr/materialCardViewOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="@dimen/radius_md">

                        <LinearLayout
                            android:id="@+id/positionBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityLiveRegion="polite"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="@dimen/space_6">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:importantForAccessibility="no"
                                android:text="@string/dropin_waitlist_entry_position_label"
                                android:textAppearance="?attr/textAppearanceBodyLarge"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:id="@+id/positionValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                android:gravity="center"
                                android:importantForAccessibility="no"
                                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                                android:textColor="?attr/colorPrimary"
                                tools:text="Vị trí 2 / 3" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_3"
                                android:gravity="center"
                                android:importantForAccessibility="no"
                                android:text="@string/dropin_waitlist_entry_hint"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Thông tin buổi và lượt chờ -->
                    <com.google.android.material.card.MaterialCardView
                        style="?attr/materialCardViewOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        app:cardCornerRadius="@dimen/radius_md">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_4">

                            <TextView
                                android:id="@+id/venueName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="Sân cầu lông Hòa Bình · Vãng lai" />

                            <TextView
                                android:id="@+id/dateTime"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_1"
                                android:textAppearance="?attr/textAppearanceBodyLarge"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="Mai, T3, 06/10 · 19:00–21:00" />

                            <com.google.android.material.divider.MaterialDivider
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginVertical="@dimen/space_3" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/dropin_waitlist_entry_party"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    android:textColor="?attr/colorOnSurfaceVariant" />

                                <TextView
                                    android:id="@+id/partyValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    android:textColor="?attr/colorOnSurface"
                                    tools:text="2 người" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/dropin_waitlist_entry_payment"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    android:textColor="?attr/colorOnSurfaceVariant" />

                                <TextView
                                    android:id="@+id/paymentValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    android:textColor="?attr/colorOnSurface"
                                    tools:text="Trả tại sân" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_2"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="@dimen/space_3"
                                    android:layout_weight="1"
                                    android:text="@string/dropin_waitlist_entry_amount"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    android:textColor="?attr/colorOnSurfaceVariant" />

                                <TextView
                                    android:id="@+id/amountValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="?attr/textAppearanceTitleMedium"
                                    android:textColor="?attr/colorOnSurface"
                                    tools:text="120.000 đ" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Chưa giữ chỗ, chưa thanh toán -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:background="@drawable/bg_info_box"
                        android:backgroundTint="?attr/colorTertiaryContainer"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_4">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_info_24"
                            app:tint="?attr/colorOnTertiaryContainer" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_3"
                            android:layout_weight="1"
                            android:text="@string/dropin_waitlist_notice"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnTertiaryContainer" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Kết quả cuối: đã rời hoặc hàng chờ đã đóng (US3, US4) -->
                <LinearLayout
                    android:id="@+id/endedGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/space_8"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_hourglass_24"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/endedTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:accessibilityHeading="true"
                        android:accessibilityLiveRegion="polite"
                        android:gravity="center"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="Không được nhận chỗ" />

                    <TextView
                        android:id="@+id/endedMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:gravity="center"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="Hàng chờ đã đóng vì buổi sắp bắt đầu." />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/findOtherButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_6"
                        android:minHeight="@dimen/touch_min"
                        android:text="@string/dropin_waitlist_find_other" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/stateViews"
            layout="@layout/include_state_views" />
    </FrameLayout>

    <!-- Thanh dưới: Rời hàng chờ (US3) -->
    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/bottomDivider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_gutter"
        android:paddingVertical="@dimen/space_3">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/leaveButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min"
            android:text="@string/dropin_waitlist_leave"
            android:textColor="@color/button_danger_outlined_text"
            app:backgroundTint="@color/button_danger_outlined_bg"
            app:rippleColor="@android:color/transparent"
            app:strokeColor="?attr/colorError" />
    </LinearLayout>
</LinearLayout>
