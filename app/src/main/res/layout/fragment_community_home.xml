<?xml version="1.0" encoding="utf-8"?>
<!--
    Cộng đồng (spec 090 US1, T028; wireframe ui/09_community-chat_buoc1_nhom.png): header dùng chung (kèm nút "Tạo nhóm"),
    2 tab "Nhóm của tôi"/"Khám phá", danh sách nhóm. Tab "Khám phá" là chỗ giữ cho US2. include_state_views chồng lên
    vùng danh sách cho loading, rỗng (nút "Tạo nhóm"), lỗi (nút "Thử lại").
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <include
        android:id="@+id/header"
        layout="@layout/view_main_tab_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_gutter" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/tabGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/screen_gutter"
        android:layout_marginTop="@dimen/space_3"
        android:contentDescription="@string/community_title_home"
        app:checkedButton="@+id/tabMyGroups"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabMyGroups"
            style="@style/Widget.SmashNow.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/community_tab_my_groups" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabDiscover"
            style="@style/Widget.SmashNow.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="@string/community_tab_discover" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/groupList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/screen_gutter"
            android:paddingTop="@dimen/space_3"
            android:paddingBottom="@dimen/space_6"
            tools:listitem="@layout/item_group" />

        <TextView
            android:id="@+id/discoverPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/space_6"
            android:text="@string/community_home_discover_placeholder"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <include
            android:id="@+id/stateViews"
            layout="@layout/include_state_views" />
    </FrameLayout>
</LinearLayout>
