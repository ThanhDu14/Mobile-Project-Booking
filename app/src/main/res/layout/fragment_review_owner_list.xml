<?xml version="1.0" encoding="utf-8"?>
<!--
    "Đánh giá của khách" cho chủ sân (spec 070 US4, T060): chip lọc cơ sở, chip "Chưa phản hồi", danh sách
    dùng item_review có nút "Phản hồi"/"Sửa phản hồi"; đủ 4 trạng thái (FR-017).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/favorite_back"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:title="@string/review_owner_title"
        app:titleTextAppearance="?attr/textAppearanceTitleLarge" />

    <HorizontalScrollView
        android:id="@+id/filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/screen_gutter">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipUnreplied"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_2"
                android:text="@string/review_owner_unreplied" />

            <!-- Chip cơ sở thêm lúc chạy theo danh sách cơ sở của chủ sân -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/venueChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/reviewList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_4"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_review" />

        <include
            android:id="@+id/stateViews"
            layout="@layout/include_state_views" />
    </FrameLayout>
</LinearLayout>
