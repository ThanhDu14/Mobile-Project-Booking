<?xml version="1.0" encoding="utf-8"?>
<!--
    Báo cáo tin nhắn vi phạm (spec 091 US5 T052, FR-014).
    5 lý do, ô mô tả tối đa 500 ký tự khi chọn "Khác", nút "Gửi báo cáo".
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_3"
        android:paddingBottom="@dimen/space_6">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/chat_title_report"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/closeButton"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/chat_cd_close"
                android:padding="@dimen/space_3"
                android:src="@drawable/ic_close_24"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/chat_report_note"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            app:cardCornerRadius="@dimen/radius_md">

            <RadioGroup
                android:id="@+id/reasonGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_3"
                android:paddingVertical="@dimen/space_1">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/reasonSpam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_min"
                    android:text="@string/chat_report_reason_spam" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/reasonOffensive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_min"
                    android:text="@string/chat_report_reason_offensive" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/reasonScam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_min"
                    android:text="@string/chat_report_reason_scam" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/reasonInappropriate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_min"
                    android:text="@string/chat_report_reason_inappropriate" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/reasonOther"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_min"
                    android:text="@string/chat_report_reason_other" />
            </RadioGroup>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/reasonError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:layout_marginTop="@dimen/space_1"
            android:text="@string/chat_report_reason_required"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorError"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/detailContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                style="@style/Widget.SmashNow.FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/chat_report_detail_label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/detailLayout"
                style="@style/Widget.SmashNow.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                app:counterEnabled="true"
                app:counterMaxLength="500">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/detailInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:hint="@string/chat_report_detail_hint"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/submitButton"
            style="@style/Widget.SmashNow.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:minHeight="@dimen/touch_min"
            android:text="@string/chat_report_send" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
