<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- Topbar matching Mockup 3 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/buttonBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/my_bookings_060_back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back_24"
            app:tint="?attr/colorOnBackground" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/buttonBack"
            android:layout_marginStart="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textCancelTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_bookings_060_cancel_booking"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textBookingSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@color/sn_ink_muted" />
        </LinearLayout>
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- Summary Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/sn_line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/textCancelBookingTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textCancelBookingSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/sn_ink_muted" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Refund Banner Card per Mockup 3 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRefund"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/sn_court_container"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_wallet_24"
                            app:tint="@color/sn_on_court_container" />

                        <TextView
                            android:id="@+id/textRefundAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/sn_on_court_container"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textRefundExplanation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/sn_on_court_container" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Reasons Title -->
            <TextView
                android:id="@+id/textCancelReasonTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/my_bookings_060_reason_title"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold" />

            <!-- Reasons Card with Dividers per Mockup 3 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/sn_line"
                app:strokeWidth="1dp">

                <RadioGroup
                    android:id="@+id/groupCancelReasons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/reasonBusy"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:paddingHorizontal="16dp"
                        android:text="@string/my_bookings_060_reason_busy"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/sn_line" />

                    <RadioButton
                        android:id="@+id/reasonWeather"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:paddingHorizontal="16dp"
                        android:text="@string/my_bookings_060_reason_weather"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/sn_line" />

                    <RadioButton
                        android:id="@+id/reasonPlayers"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:paddingHorizontal="16dp"
                        android:text="@string/my_bookings_060_reason_players"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/sn_line" />

                    <RadioButton
                        android:id="@+id/reasonWrongBooking"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:paddingHorizontal="16dp"
                        android:text="@string/my_bookings_060_reason_wrong"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/sn_line" />

                    <RadioButton
                        android:id="@+id/reasonOther"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:paddingHorizontal="16dp"
                        android:text="@string/my_bookings_060_reason_other"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />
                </RadioGroup>
            </com.google.android.material.card.MaterialCardView>

            <!-- Other Reason Input Field -->
            <EditText
                android:id="@+id/inputOtherReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill_confirmed"
                android:backgroundTint="?attr/colorSurface"
                android:hint="@string/my_bookings_060_other_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:minHeight="48dp"
                android:padding="12dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:visibility="gone" />

            <!-- Policy Warning Box per Mockup 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_pill_confirmed"
                android:backgroundTint="@color/sn_surface_sunken"
                android:gravity="top"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_info_24"
                    app:tint="@color/sn_ink_muted" />

                <TextView
                    android:id="@+id/textCancelPolicy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:lineSpacingExtra="3dp"
                    android:text="Nếu hủy dưới 4 giờ trước giờ chơi: mất tiền cọc; đơn trả bằng ví bị phạt 30% và được hoàn 70%. Server quyết định theo giờ máy chủ lúc nhận yêu cầu."
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/sn_ink" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Bar with "Giữ đơn" and red "Xác nhận hủy" per Mockup 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonKeepBooking"
            style="@style/Widget.SmashNow.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:text="@string/my_bookings_060_keep"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            app:cornerRadius="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonConfirmCancel"
            style="@style/Widget.SmashNow.Button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:backgroundTint="@color/sn_danger"
            android:enabled="false"
            android:text="@string/my_bookings_060_confirm_cancel"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/sn_on_danger"
            app:cornerRadius="24dp" />
    </LinearLayout>
</LinearLayout>
