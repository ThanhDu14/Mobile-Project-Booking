<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sn_surface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sn_surface_raised"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back_24"
            app:navigationIconTint="@color/sn_ink"
            app:title="@string/recurring_title"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium"
            app:titleTextColor="@color/sn_ink" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewConfig"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="96dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Section 1: Chọn thứ trong tuần -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/recurring_select_days_label"
                android:textColor="@color/sn_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDayChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_day_of_week_chip" />

            <!-- Section 2: Khung giờ cố định -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/recurring_time_label"
                android:textColor="@color/sn_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilStartTime"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:hint="@string/recurring_from_time"
                    app:boxBackgroundColor="@color/sn_surface_raised"
                    app:boxStrokeColor="@color/sn_court"
                    app:hintTextColor="@color/sn_court">

                    <AutoCompleteTextView
                        android:id="@+id/actvStartTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textColor="@color/sn_ink"
                        android:textStyle="bold" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEndTime"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:hint="@string/recurring_to_time"
                    app:boxBackgroundColor="@color/sn_surface_raised"
                    app:boxStrokeColor="@color/sn_court"
                    app:hintTextColor="@color/sn_court">

                    <AutoCompleteTextView
                        android:id="@+id/actvEndTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textColor="@color/sn_ink"
                        android:textStyle="bold" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvSlotCountNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/recurring_time_note"
                android:textColor="@color/sn_ink_muted"
                android:textSize="12sp" />

            <!-- Section 3: Sân ưu tiên (Dropdown không bị đè label) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPreferredCourt"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:hint="@string/recurring_preferred_court_label"
                app:boxBackgroundColor="@color/sn_surface_raised"
                app:boxStrokeColor="@color/sn_court"
                app:hintTextColor="@color/sn_court">

                <AutoCompleteTextView
                    android:id="@+id/actvPreferredCourt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="@color/sn_ink"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Section 4: Số tuần (Đổi thành Dropdown theo Mockup A2) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDurationWeeks"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/recurring_duration_weeks_label"
                app:boxBackgroundColor="@color/sn_surface_raised"
                app:boxStrokeColor="@color/sn_court"
                app:hintTextColor="@color/sn_court">

                <AutoCompleteTextView
                    android:id="@+id/actvDurationWeeks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="@color/sn_ink"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Section 5: Bắt đầu từ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/recurring_start_week_label"
                android:textColor="@color/sn_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgStartWeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipThisWeek"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/recurring_start_this_week" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipNextWeek"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recurring_start_next_week" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Nút kiểm tra khả dụng -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckAvailability"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/sn_court"
                android:fontFamily="sans-serif-medium"
                android:text="@string/recurring_btn_check_availability"
                android:textColor="@color/sn_on_court"
                android:textSize="15sp"
                app:cornerRadius="10dp" />

            <!-- ProgressBar khi đang kiểm tra -->
            <ProgressBar
                android:id="@+id/progressBarChecking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <!-- Kết quả kiểm tra khả dụng (Màn kết quả bám Mockup A3) -->
            <LinearLayout
                android:id="@+id/layoutCheckResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Thẻ tổng hợp buổi chơi -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSummaryOverview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/sn_surface_raised"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/sn_line"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Header thẻ tổng hợp -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="14dp">

                            <TextView
                                android:id="@+id/tvSummaryHeader"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:text="16 buổi · T3 và T5 · 19:00 – 21:00"
                                android:textColor="@color/sn_ink"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvConflictBadgePill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_wordmark_pill"
                                android:backgroundTint="@color/sn_lamp_container"
                                android:fontFamily="sans-serif-medium"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="1 trùng lịch"
                                android:textColor="@color/sn_on_lamp_container"
                                android:textSize="12sp"
                                android:visibility="gone" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/sn_line" />

                        <!-- Danh sách các buổi đặt (Tối đa 4 buổi đầu) -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvSessionSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:listitem="@layout/item_recurring_session_summary" />

                        <!-- Dòng "... và N buổi nữa" -->
                        <TextView
                            android:id="@+id/tvMoreSessions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="10dp"
                            android:text="… và 12 buổi nữa"
                            android:textColor="@color/sn_ink_muted"
                            android:textSize="13sp"
                            android:visibility="gone" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Danh sách xung đột inline (chỉ hiện khi có buổi trùng) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvConflicts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_recurring_conflict" />

                <!-- Cảnh báo khi dưới 4 buổi -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMinSessionsWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/sn_lamp_container"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/sn_line"
                    app:strokeWidth="1dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvMinSessionsWarning"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/recurring_min_sessions_warning"
                            android:textColor="@color/sn_on_lamp_container"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBackToGrid"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="10dp"
                            android:text="@string/recurring_btn_back_to_grid"
                            android:textColor="@color/sn_on_lamp_container"
                            app:strokeColor="@color/sn_on_lamp_container" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Bar cố định theo mockup A3 (Bottom Bar 040 chuẩn) -->
    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/sn_surface_raised"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBottomTotalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="0 đ"
                android:textColor="@color/sn_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBottomDepositNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="16 buổi · cọc 30% hoặc trả trước toàn bộ"
                android:textColor="@color/sn_ink_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProceed"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:backgroundTint="@color/sn_court"
            android:enabled="false"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="20dp"
            android:text="@string/recurring_btn_hold_chain"
            android:textColor="@color/sn_on_court"
            android:textSize="14sp"
            app:cornerRadius="24dp" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
