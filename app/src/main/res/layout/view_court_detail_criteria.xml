<?xml version="1.0" encoding="utf-8"?>
<!-- Một thanh tiêu chí ở khối tổng quan đánh giá (ui-screens §2 mục 7): nhãn, thanh 0–5, điểm. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_1"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/criteriaLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="Chất lượng sân" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/criteriaBar"
        android:layout_width="@dimen/court_detail_criteria_bar_width"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_2"
        android:importantForAccessibility="no"
        android:max="50"
        app:trackCornerRadius="2dp"
        tools:progress="45" />

    <TextView
        android:id="@+id/criteriaValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurface"
        tools:text="4,5" />
</LinearLayout>
