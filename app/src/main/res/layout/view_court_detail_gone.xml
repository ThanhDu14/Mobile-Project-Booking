<?xml version="1.0" encoding="utf-8"?>
<!-- Cơ sở đã xóa (spec 030 US6, FR-022): phủ toàn màn hình chi tiết sân. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_6">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_error_24"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/goneTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:accessibilityHeading="true"
        android:gravity="center"
        android:text="@string/court_detail_gone"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:gravity="center"
        android:text="@string/court_detail_gone_message"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/goneBackButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_6"
        android:minHeight="@dimen/touch_min"
        android:text="@string/court_detail_back" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/goneRemoveFavoriteButton"
        style="@style/Widget.SmashNow.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_min"
        android:text="@string/court_detail_remove_favorite"
        android:visibility="gone" />
</LinearLayout>
