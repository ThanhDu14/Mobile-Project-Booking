<?xml version="1.0" encoding="utf-8"?>
<!-- Một dòng lịch sử: chạm để tìm lại, ✕ để xóa riêng mục này. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/screen_gutter"
    android:paddingEnd="@dimen/space_1">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_history_24"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_3"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingVertical="@dimen/space_2"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <ImageButton
        android:id="@+id/delete"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_close_24"
        app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
