<?xml version="1.0" encoding="utf-8"?>
<!-- Sửa hồ sơ (spec 011 US1, wireframe ui/01_account_buoc2_sua-ho-so.png, contracts/ui-screens.md §2). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/account_back"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:title="@string/account_edit_title"
        app:titleTextAppearance="?attr/textAppearanceTitleLarge" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/screen_gutter"
                android:paddingBottom="@dimen/space_6"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/auth_form_max_width">

                <!-- Ảnh đại diện; vòng tiến trình phủ lên khi đang xử lý / tải lên. -->
                <FrameLayout
                    android:layout_width="@dimen/account_avatar_large"
                    android:layout_height="@dimen/account_avatar_large"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_4">

                    <TextView
                        android:id="@+id/avatarInitials"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_account_avatar_initials"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textAppearance="?attr/textAppearanceDisplaySmall"
                        android:textColor="@color/sn_on_court_container"
                        tools:text="HN" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/avatarImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.SmashNow.Circle" />

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/avatarProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:contentDescription="@string/account_avatar_uploading"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorSize="@dimen/account_avatar_large" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_3"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/changeAvatarButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_min"
                        android:text="@string/account_avatar_change"
                        app:icon="@drawable/ic_photo_camera_24" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/removeAvatarButton"
                        style="@style/Widget.SmashNow.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:text="@string/account_avatar_remove"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:gravity="center"
                    android:text="@string/account_avatar_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    style="@style/Widget.SmashNow.FieldLabel"
                    android:labelFor="@id/nameInput"
                    android:text="@string/account_name_label" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/nameLayout"
                    style="@style/Widget.SmashNow.TextInputLayout"
                    app:counterEnabled="true"
                    app:counterMaxLength="50">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="name"
                        android:imeOptions="actionDone"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLength="50" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Email chỉ đọc (đổi ở US7). Tài khoản chỉ có số điện thoại thì ẩn. -->
                <LinearLayout
                    android:id="@+id/emailGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.SmashNow.FieldLabel"
                        android:text="@string/account_email_label" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_info_box"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/space_4">

                        <TextView
                            android:id="@+id/emailValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceBodyLarge"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="nam.le@email.com" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/emailUnverifiedChip"
                            style="@style/Widget.SmashNow.AccountChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/account_email_unverified"
                            android:textColor="@color/sn_on_lamp_container"
                            app:chipBackgroundColor="@color/sn_lamp_container"
                            app:chipStrokeWidth="0dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/account_email_change_hint"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <TextView
                    android:id="@+id/levelLabel"
                    style="@style/Widget.SmashNow.FieldLabel"
                    android:text="@string/account_level_label" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/levelGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/account_level_label"
                    app:selectionRequired="false"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/levelBeginner"
                        style="@style/Widget.SmashNow.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/account_level_beginner" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/levelIntermediate"
                        style="@style/Widget.SmashNow.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/account_level_intermediate" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/levelAdvanced"
                        style="@style/Widget.SmashNow.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/account_level_advanced" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/account_districts_label"
                        android:textAppearance="@style/TextAppearance.SmashNow.Label"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/districtsCounter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="2/5" />
                </LinearLayout>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/districtChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/addDistrictButton"
                    style="@style/Widget.SmashNow.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:text="@string/account_districts_add"
                    app:icon="@drawable/ic_add_24"
                    app:iconTint="?attr/colorOnSurface" />

                <!-- Danh mục khu vực lỗi: lỗi + "Thử lại" ngay trong mục, các ô khác vẫn sửa được. -->
                <LinearLayout
                    android:id="@+id/districtsError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        style="@style/Widget.SmashNow.FormError"
                        android:layout_width="0dp"
                        android:layout_marginTop="0dp"
                        android:layout_weight="1"
                        android:text="@string/account_districts_error" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/districtsRetryButton"
                        style="@style/Widget.SmashNow.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/account_retry" />
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Thanh dưới: "Có thay đổi chưa lưu" + "Lưu thay đổi". -->
    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sn_surface_raised"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_gutter"
        android:paddingVertical="@dimen/space_3">

        <TextView
            android:id="@+id/unsavedLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:text="@string/account_unsaved_changes"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="invisible"
            tools:visibility="visible" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveButton"
                style="@style/Widget.SmashNow.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account_save" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/saveProgress"
                style="@style/Widget.SmashNow.ButtonProgress"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
