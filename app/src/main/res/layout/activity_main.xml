<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_main" />

    <!-- BottomNav người chơi: chỉ hiện ở màn gốc của tab (MainActivity.updateBottomNav). -->
    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/sn_surface_raised"
            app:itemActiveIndicatorStyle="@style/Widget.SmashNow.BottomNav.ActiveIndicator"
            app:itemIconTint="@color/sn_bottom_nav_item"
            app:itemTextColor="@color/sn_bottom_nav_item"
            app:itemTextAppearanceActive="@style/TextAppearance.SmashNow.BottomNav.Active"
            app:itemTextAppearanceInactive="@style/TextAppearance.SmashNow.BottomNav"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/menu_player_bottom_nav" />
    </LinearLayout>

</LinearLayout>
