<?xml version="1.0" encoding="utf-8"?>
<!--
    Trạng thái loading, rỗng, lỗi dùng chung cho màn hình danh sách (core/ui/StateViews.kt).
    Đặt chồng lên vùng nội dung; StateViews ẩn/hiện từng phần theo UiState.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/stateLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/stateMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/space_6"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/stateIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            app:tint="?attr/colorOnSurfaceVariant"
            tools:src="@drawable/ic_error_24" />

        <TextView
            android:id="@+id/stateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="@string/favorite_empty" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/stateAction"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:visibility="gone"
            tools:text="@string/common_retry"
            tools:visibility="visible" />
    </LinearLayout>
</FrameLayout>
