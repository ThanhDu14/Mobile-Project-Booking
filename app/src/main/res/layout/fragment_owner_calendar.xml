<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:paddingHorizontal="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_4"
        android:text="@string/owner_calendar_title"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface" />

    <Spinner
        android:id="@+id/venueSpinner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_min"
        android:layout_marginHorizontal="@dimen/screen_gutter"
        android:contentDescription="@string/owner_calendar_select_venue" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_gutter">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dayMode"
            style="@style/Widget.SmashNow.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/owner_calendar_day" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/weekMode"
            style="@style/Widget.SmashNow.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:text="@string/owner_calendar_week" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/previousPeriod"
            style="@style/Widget.SmashNow.Button.Text"
            android:layout_width="48dp"
            android:layout_height="@dimen/touch_min"
            android:contentDescription="@string/owner_calendar_previous"
            android:minHeight="@dimen/touch_min"
            android:text="‹"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <TextView
            android:id="@+id/periodLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nextPeriod"
            style="@style/Widget.SmashNow.Button.Text"
            android:layout_width="48dp"
            android:layout_height="@dimen/touch_min"
            android:contentDescription="@string/owner_calendar_next"
            android:minHeight="@dimen/touch_min"
            android:text="›"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/refresh"
        style="@style/Widget.SmashNow.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_min"
        android:layout_gravity="end"
        android:layout_marginEnd="@dimen/screen_gutter"
        android:minHeight="@dimen/touch_min"
        android:text="@string/common_retry" />

    <ProgressBar
        android:id="@+id/loading"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/errorText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/space_4"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorError"
        android:visibility="gone" />

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/space_4"
        android:text="@string/owner_calendar_empty"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <HorizontalScrollView
        android:id="@+id/calendarScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/calendarContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_3"
            android:paddingBottom="@dimen/space_4" />
    </HorizontalScrollView>
</LinearLayout>
