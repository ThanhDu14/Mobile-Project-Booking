<?xml version="1.0" encoding="utf-8"?>
<!-- Điều khoản sử dụng / Chính sách quyền riêng tư (res/raw/*_vi.html, FR-003). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/auth_back"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:titleTextAppearance="?attr/textAppearanceTitleLarge" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:maxWidth="@dimen/auth_form_max_width"
            android:paddingHorizontal="@dimen/screen_gutter"
            android:paddingBottom="@dimen/space_6"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface"
            android:textIsSelectable="true" />
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
