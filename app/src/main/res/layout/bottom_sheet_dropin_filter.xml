<?xml version="1.0" encoding="utf-8"?>
<!--
    Bộ lọc buổi vãng lai (spec 080 US1, T027, FR-003): nhiều quận (tối đa 15), ngày (hôm nay tới 30 ngày tới),
    4 khung giờ, 3 trình độ, giá tối đa; "Xóa hết" và "Áp dụng".
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_gutter"
            android:paddingBottom="@dimen/space_4">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/dropin_filter_title"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorOnSurface" />

            <!-- Khu vực -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:accessibilityHeading="true"
                android:text="@string/dropin_filter_district"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/districtHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Chọn tối đa 15 quận" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/districtLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:indeterminate="true"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/districtError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dropin_filter_district_load_failed"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorError" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/districtRetry"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dropin_retry" />
            </LinearLayout>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/districtGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2" />

            <!-- Ngày -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:accessibilityHeading="true"
                android:text="@string/dropin_filter_date"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dateButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_calendar_24"
                    tools:text="30 ngày tới" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dateClear"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:text="@string/dropin_filter_date_clear"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Khung giờ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:accessibilityHeading="true"
                android:text="@string/dropin_filter_slot"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/slotGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/slotMorning"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dropin_slot_morning" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/slotNoon"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dropin_slot_noon" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/slotAfternoon"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dropin_slot_afternoon" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/slotEvening"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dropin_slot_evening" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Trình độ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:accessibilityHeading="true"
                android:text="@string/dropin_filter_level"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/levelGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/levelBeginner"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dropin_level_beginner" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/levelIntermediate"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dropin_level_intermediate" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/levelAdvanced"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dropin_level_advanced" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Giá tối đa -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/maxPriceLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:hint="@string/dropin_filter_max_price"
                app:placeholderText="@string/dropin_filter_max_price_hint"
                app:suffixText="@string/dropin_filter_max_price_suffix">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/maxPriceInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="9" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_gutter"
        android:paddingVertical="@dimen/space_3">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearAllButton"
            style="@style/Widget.SmashNow.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/dropin_filter_clear_all" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/applyButton"
            style="@style/Widget.SmashNow.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:layout_weight="1"
            android:text="@string/dropin_filter_apply" />
    </LinearLayout>
</LinearLayout>
