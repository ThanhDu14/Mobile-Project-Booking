<?xml version="1.0" encoding="utf-8"?>
<!--
    Thẻ một lượt trong "Lượt vãng lai của tôi" (spec 080 US3, T047; wireframe ui/08_drop-in_buoc5).
    Nhãn trạng thái ("Đã đăng ký · 2 người" ở "Sắp tới", nhãn kết quả ở "Đã qua"), mã vé, tên cơ sở, ngày giờ,
    số người · trạng thái thanh toán, nhãn "Buổi đã thay đổi" (AC 3.5), nút "Xem vé" cho lượt sắp tới. Màu theo theme.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="?attr/materialCardViewOutlinedStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_3"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/radius_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:importantForAccessibility="no"
            android:orientation="horizontal">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/labelChips"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:chipSpacingVertical="0dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/statusChip"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    app:chipBackgroundColor="?attr/colorPrimaryContainer"
                    app:chipIconTint="?attr/colorOnPrimaryContainer"
                    app:chipStrokeWidth="0dp"
                    tools:chipIcon="@drawable/ic_check_20"
                    tools:text="Đã đăng ký · 2 người" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/changedChip"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:text="@string/dropin_label_session_changed"
                    android:textColor="?attr/colorOnTertiaryContainer"
                    android:visibility="gone"
                    app:chipBackgroundColor="?attr/colorTertiaryContainer"
                    app:chipStrokeWidth="0dp"
                    tools:visibility="visible" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/ticketCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                tools:text="DI-7K2P"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/venueName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:importantForAccessibility="no"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Sân cầu lông Hòa Bình" />

        <TextView
            android:id="@+id/dateTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:importantForAccessibility="no"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface"
            tools:text="Mai, T3 06/10 · 19:00–21:00" />

        <TextView
            android:id="@+id/detailLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:importantForAccessibility="no"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="2 người · Đã thanh toán 120.000 đ" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/viewTicketButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:minHeight="@dimen/touch_min"
            android:text="@string/dropin_mine_view_ticket"
            android:visibility="gone"
            app:icon="@drawable/ic_qr_code_scanner_24"
            tools:visibility="visible" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
