<?xml version="1.0" encoding="utf-8"?>
<!-- Một sân trong Danh sách sân: tên + mặt sân, chip trạng thái, nút lên/xuống để sắp thứ tự và menu (Sửa, Ngừng/Hoạt động lại). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_2"
    app:cardBackgroundColor="@color/sn_surface_raised"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="0dp"
    app:strokeColor="@color/sn_line"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/space_2"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_1">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                tools:text="Sân 1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/surface"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="PU" />

                <TextView
                    android:id="@+id/active"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:background="@drawable/bg_owner_status_chip"
                    android:paddingHorizontal="@dimen/space_2"
                    android:paddingVertical="2dp"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    tools:backgroundTint="@color/sn_court_container"
                    tools:text="Đang hoạt động" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:minWidth="@dimen/touch_min"
            android:minHeight="@dimen/touch_min"
            android:id="@+id/up"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/owner_court_up"
            android:src="@drawable/ic_keyboard_arrow_up_24"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:minWidth="@dimen/touch_min"
            android:minHeight="@dimen/touch_min"
            android:id="@+id/down"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/owner_court_down"
            android:src="@drawable/ic_keyboard_arrow_down_24"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:minWidth="@dimen/touch_min"
            android:minHeight="@dimen/touch_min"
            android:id="@+id/more"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/owner_court_more"
            android:src="@drawable/ic_more_vert_24"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
