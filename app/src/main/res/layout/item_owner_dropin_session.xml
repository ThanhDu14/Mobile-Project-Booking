<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/space_2"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="0dp"
    app:strokeColor="@color/sn_line"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_4">

        <!-- Row 1: Thời gian & Trạng thái badge (Wireframe 6) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                tools:text="Hôm nay · 18:00 – 20:00" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_confirmed"
                android:paddingHorizontal="@dimen/space_2"
                android:paddingVertical="@dimen/space_1"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/sn_on_court_container"
                android:textStyle="bold"
                tools:text="Đang mở" />
        </LinearLayout>

        <!-- Row 2: Sân, trình độ, giá vé -->
        <TextView
            android:id="@+id/capacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Sân 3 · Trình trung bình · 60.000 đ/người" />

        <!-- Row 3: Progress indicator -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/capacityProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            app:indicatorColor="@color/sn_court"
            app:trackColor="@color/sn_line"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp" />

        <!-- Row 4: Đã đăng ký & Hành động xem danh sách -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/capacitySummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                tools:text="14/16 đã đăng ký" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/roster"
                style="@style/Widget.SmashNow.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:paddingHorizontal="@dimen/space_3"
                android:text="@string/owner_dropin_roster" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
