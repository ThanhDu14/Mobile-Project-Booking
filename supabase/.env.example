# Mẫu biến môi trường cho Edge Function khi chạy local (`supabase functions serve --env-file supabase/.env`).
# Sao chép thành supabase/.env rồi điền giá trị thật. KHÔNG commit file .env.
FIREBASE_PROJECT_ID=demo-smashnow
# JSON service account của Firebase, viết trên một dòng
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"demo-smashnow","private_key":"-----BEGIN PRIVATE KEY-----\nFAKE\n-----END PRIVATE KEY-----\n","client_email":"fake@demo-smashnow.iam.gserviceaccount.com"}
